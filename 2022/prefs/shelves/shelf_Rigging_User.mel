        -annotation "0020'''\nCreated on 2020. 12. 22.\nNXN\n@author: LeeSungJun\n'''\nimport maya.cmds as cmds\nimport pymel.core as pm\nimport cPickle\nimport logging\n\n_logger = logging.getLogger(__name__)\n\n\n\ndef getTransform(root):\n        \n        obj = pm.ls(root,dag=True ,type='transform')\n        result = getKeyframes(obj)\n        \n        return result\n   \ndef getKeyframes(objs):\n        \n        all_key_frames = {}\n        attr_list =[]\n        time_list = []\n        value_list =[]\n        \n        for obj in objs:\n            anim_attr = pm.listAnimatable(obj)\n            \n            for attr in anim_attr:\n                num_key_frames = pm.keyframe(attr,q=True,keyframeCount=True)\n                \n                if (num_key_frames > 0):\n                    \n                    times = pm.keyframe(attr,q=True,index = (0,num_key_frames),timeChange=True)\n                    values = pm.keyframe(attr,q=True,index = (0,num_key_frames),valueChange=T
rue)\n                    \n                    for i in range(0,num_key_frames):\n                        \n                        attr_list.append('%s'%attr)\n                        time_list.append(times[i])\n                        value_list.append(values[i])\n        \n        all_key_frames['Attribute'] = attr_list\n        all_key_frames['Time'] = time_list\n        all_key_frames['Value'] = value_list\n        \n        return all_key_frames\n\n\n\ndef writeFile(path,keyData):\n        \n    with open(path,'wb') as f:\n        f.write(cPickle.dumps(keyData,True))\n\n    return None\n\n\ndef expAnim(*args):\n   \n    if 0 != len(pm.ls('ControllersParent')):\n        node = pm.ls('ControllersParent')\n    \n    elif 0 != len(pm.ls('*:ControllersParent')):\n        node = pm.ls('*:ControllersParent')\n        \n    else:\n        _logger.error('No object matches name: ControllersParent')\n        \n    \n    get_key_data = getTransform(node[0])\n    path = cmds.textField(fileP
athLine,q=True,text=True)\n    writeFile(path , get_key_data)\n    \n    _logger.info('export path: %s'%path)\n    \ndef saveFile(*args):\n    \n    singleFilter = \"bin Files (*.bin)\"\n    file_ = cmds.fileDialog2(fileFilter=singleFilter, dialogStyle=2)\n    cmds.textField(filePathLine,e=True,text='%s'%file_[0])\n\n\n\nif(cmds.window('animFacialExp',q=1,ex=1)):cmds.deleteUI('animFacialExp')\ncmds.window('animFacialExp',w=480,h=10,mb=1,resizeToFitChildren=True, sizeable=False)\ncmds.columnLayout(adj=1)\ncmds.rowLayout(nc=2)\nfilePathLine = cmds.textField(w=400)\ncmds.button(label = 'Save File',c = saveFile)\ncmds.columnLayout(p='animFacialExp',rs=10,adj=1)\ncmds.separator(w=400)\ncmds.button(label ='Export Anim Data',c=expAnim)\ncmds.showWindow('animFacialExp')\n" 
        -enableBackground 0
        -backgroundColor 0 0 0 
        -highlightColor 0.321569 0.521569 0.65098 
        -align "center" 
        -label "0020'''\nCreated on 2020. 12. 22.\nNXN\n@author: LeeSungJun\n'''\nimp..." 
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -imageOverlayLabel "BrgFFX" 
        -overlayLabelColor 0.8 0.8 0.8 
        -overlayLabelBackColor 0 0 0 0.5 
        -image "pythonFamily.png" 
        -image1 "pythonFamily.png" 
        -style "iconOnly" 
        -marginWidth 1
        -marginHeight 1
        -command "'''\nCreated on 2020. 12. 22.\nNXN\n@author: LeeSungJun\n'''\nimport maya.cmds as cmds\nimport pymel.core as pm\nimport cPickle\nimport logging\n\n_logger = logging.getLogger(__name__)\n\n\n\ndef getTransform(root):\n        \n        obj = pm.ls(root,dag=True ,type='transform')\n        result = getKeyframes(obj)\n        \n        return result\n   \ndef getKeyframes(objs):\n        \n        all_key_frames = {}\n        attr_list =[]\n        time_list = []\n        value_list =[]\n        \n        for obj in objs:\n            anim_attr = pm.listAnimatable(obj)\n            \n            for attr in anim_attr:\n                num_key_frames = pm.keyframe(attr,q=True,keyframeCount=True)\n                \n                if (num_key_frames > 0):\n                    \n                    times = pm.keyframe(attr,q=True,index = (0,num_key_frames),timeChange=True)\n                    values = pm.keyframe(attr,q=True,index = (0,num_key_frames),valueChange=True)\n 
                   \n                    for i in range(0,num_key_frames):\n                        \n                        attr_list.append('%s'%attr)\n                        time_list.append(times[i])\n                        value_list.append(values[i])\n        \n        all_key_frames['Attribute'] = attr_list\n        all_key_frames['Time'] = time_list\n        all_key_frames['Value'] = value_list\n        \n        return all_key_frames\n\n\n\ndef writeFile(path,keyData):\n        \n    with open(path,'wb') as f:\n        f.write(cPickle.dumps(keyData,True))\n\n    return None\n\n\ndef expAnim(*args):\n   \n    if 0 != len(pm.ls('ControllersParent')):\n        node = pm.ls('ControllersParent')\n    \n    elif 0 != len(pm.ls('*:ControllersParent')):\n        node = pm.ls('*:ControllersParent')\n        \n    else:\n        _logger.error('No object matches name: ControllersParent')\n        \n    \n    get_key_data = getTransform(node[0])\n    path = cmds.textField(filePathLine
,q=True,text=True)\n    writeFile(path , get_key_data)\n    \n    _logger.info('export path: %s'%path)\n    \ndef saveFile(*args):\n    \n    singleFilter = \"bin Files (*.bin)\"\n    file_ = cmds.fileDialog2(fileFilter=singleFilter, dialogStyle=2)\n    cmds.textField(filePathLine,e=True,text='%s'%file_[0])\n\n\n\nif(cmds.window('animFacialExp',q=1,ex=1)):cmds.deleteUI('animFacialExp')\ncmds.window('animFacialExp',w=480,h=10,mb=1,resizeToFitChildren=True, sizeable=False)\ncmds.columnLayout(adj=1)\ncmds.rowLayout(nc=2)\nfilePathLine = cmds.textField(w=400)\ncmds.button(label = 'Save File',c = saveFile)\ncmds.columnLayout(p='animFacialExp',rs=10,adj=1)\ncmds.separator(w=400)\ncmds.button(label ='Export Anim Data',c=expAnim)\ncmds.showWindow('animFacialExp')\n" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
