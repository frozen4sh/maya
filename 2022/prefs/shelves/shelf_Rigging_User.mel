        -command "import maya.cmds as cmds\n \ndef setAnimRange():\n    objs = cmds.ls(sl= True)\n    timeRange= []\n    for obj in objs:\n        #obj = objs[0]\n        animAttributes = cmds.listAnimatable(obj)\n        \n        for attribute in animAttributes:\n            numKeyframes = cmds.keyframe(attribute, q= True, keyframeCount= True)\n            \n            if (numKeyframes > 0):\n                #print(\"--------------------------------\")\n                #print(\"Found \", numKeyframes, \" keyframes on \", attribute)\n                \n                times = cmds.keyframe(attribute, q= True, index= (0, numKeyframes), timeChange= True)\n                \n                values = cmds.keyframe(attribute, q= True, index= (0, numKeyframes), valueChange= True)\n                \n                #print('frame#, time, value')\n                for i in range(0, numKeyframes):\n                    #print(i, times[i], values[i])\n                    timeRange.append(times[i])
\n                \n                #print(\"--------------------------------\")\n    keyRange= sorted(timeRange)\n    \n    cmds.playbackOptions(minTime= keyRange[0], maxTime= keyRange[-1])\n    #Justin Added set render range\n    cmds.setAttr('defaultRenderGlobals.startFrame', keyRange[0] )\n    cmds.setAttr('defaultRenderGlobals.endFrame',  keyRange[-1] )\n    \n \nsetAnimRange()" 
