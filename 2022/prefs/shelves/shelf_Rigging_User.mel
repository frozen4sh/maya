Rig_L_Finger02\",\"'+charDef+'\",52,0)')\n    mel.eval('setCharacterObject(\"Rig_L_Finger1\",\"'+charDef+'\",54,0)')\n    mel.eval('setCharacterObject(\"Rig_L_Finger11\",\"'+charDef+'\",55,0)')\n    mel.eval('setCharacterObject(\"Rig_L_Finger12\",\"'+charDef+'\",56,0)')\n    mel.eval('setCharacterObject(\"Rig_L_Finger2\",\"'+charDef+'\",58,0)')\n    mel.eval('setCharacterObject(\"Rig_L_Finger21\",\"'+charDef+'\",59,0)')\n    mel.eval('setCharacterObject(\"Rig_L_Finger22\",\"'+charDef+'\",60,0)')\n    mel.eval('setCharacterObject(\"Rig_L_Finger3\",\"'+charDef+'\",62,0)')\n    mel.eval('setCharacterObject(\"Rig_L_Finger31\",\"'+charDef+'\",63,0)')\n    mel.eval('setCharacterObject(\"Rig_L_Finger32\",\"'+charDef+'\",64,0)')\n    mel.eval('setCharacterObject(\"Rig_L_Finger4\",\"'+charDef+'\",66,0)')\n    mel.eval('setCharacterObject(\"Rig_L_Finger41\",\"'+charDef+'\",67,0)')\n    mel.eval('setCharacterObject(\"Rig_L_Finger42\",\"'+charDef+'\",68,0)')\n    \n    \n\n    mel.eval('setCharac
terObject(\"Rig_R_Clavicle\",\"'+charDef+'\",19,0)')\n    mel.eval('setCharacterObject(\"Rig_R_UpperArm\",\"'+charDef+'\",12,0)')\n    mel.eval('setCharacterObject(\"Rig_R_ForeArm\",\"'+charDef+'\",13,0)')\n    mel.eval('setCharacterObject(\"Rig_R_Hand\",\"'+charDef+'\",14,0)')\n    mel.eval('setCharacterObject(\"Rig_R_Finger0\",\"'+charDef+'\",74,0)')\n    mel.eval('setCharacterObject(\"Rig_R_Finger01\",\"'+charDef+'\",75,0)')\n    mel.eval('setCharacterObject(\"Rig_R_Finger02\",\"'+charDef+'\",76,0)')\n    mel.eval('setCharacterObject(\"Rig_R_Finger1\",\"'+charDef+'\",78,0)')\n    mel.eval('setCharacterObject(\"Rig_R_Finger11\",\"'+charDef+'\",79,0)')\n    mel.eval('setCharacterObject(\"Rig_R_Finger12\",\"'+charDef+'\",80,0)')\n    mel.eval('setCharacterObject(\"Rig_R_Finger2\",\"'+charDef+'\",82,0)')\n    mel.eval('setCharacterObject(\"Rig_R_Finger21\",\"'+charDef+'\",83,0)')\n    mel.eval('setCharacterObject(\"Rig_R_Finger22\",\"'+charDef+'\",84,0)')\n    mel.eval('setCharacterObj
