        -annotation "'''\nCreated on 2020. 8. 7.\nNXN\n@author: LeeSungJun\n'''\nimport maya.cmds as cmds\nimport pymel.core as pm\nimport maya.mel as mel\n\nchr_name='Character'\n\ndef create(charName):\n   \n\n    charDef = mel.eval('hikCreateCharacter(\"'+charName+'\")')\n\n    try:\n        mel.eval('hikUpdateCharacterList()')\n        mel.eval('hikSelectDefinitionTab()')\n    except:\n        pass\n\n    \n    mel.eval('setCharacterObject(\"Root\",\"'+charDef+'\",0,0)')\n    mel.eval('setCharacterObject(\"Rig_Pelvis\",\"'+charDef+'\",1,0)')\n    mel.eval('setCharacterObject(\"Rig_Spine\",\"'+charDef+'\",8,0)')\n    mel.eval('setCharacterObject(\"Rig_Spine1\",\"'+charDef+'\",23,0)')\n    mel.eval('setCharacterObject(\"Rig_Spine2\",\"'+charDef+'\",24,0)')\n\n    mel.eval('setCharacterObject(\"Rig_L_Thigh\",\"'+charDef+'\",2,0)')\n    mel.eval('setCharacterObject(\"Rig_L_Calf\",\"'+charDef+'\",3,0)')\n    mel.eval('setCharacterObject(\"Rig_L_Foot\",\"'+charDef+'\",4,0)')\n    mel.ev
