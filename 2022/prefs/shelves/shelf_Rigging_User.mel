        -command "# -*- coding: utf-8 -*- \n'''\n2020.04.02\nï¿½ï¿½ï¿½ï¿½ ï¿½Ì¸ï¿½ ï¿½ï¿½ï¿½ï¿½ ï¿½Ì¸ï¿½ ï¿½ß¿ï¿½ - ï¿½ï¿½ï¿½ï¿½ ï¿½ï¿½ï¿½ï¿½ï¿½Ï±ï¿½ ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½.\n\n\nï¿½ï¿½ï¿½ß¹Ú½ï¿½ ï¿½Æ¹ï¿½ï¿½ï¿½ ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿?È®ï¿½Î¿ï¿½\n\n\nimport sys\nsys.path.append(\"Z:/Teams/CINEMA/03.Animation/temp/animation_part_scripts/\")\nimport risefolderopen as rfo\nfrom risefolderopen import *\nreload(rfo)\nrfo.UI()\n'''\n\n\nimport maya.cmds as cmds\nimport os\nimport glob\nimport maya.mel as mel\n\n\n\nfilename=cmds.file(q=1,ns=1)\nfilenames=filename.split('_')\n#[u'9999', u'0010', u'anim', u'polishing', u'lod0', u'012', u'edit', u'03', u'02']\n\n\nprojectname = 'rise'\n\n\nglobal setdrive\nsetdrive = 'Z' # ï¿½Ê±â¼³ï¿½ï¿½ï¿½ï¿½ Z ï¿½ï¿½ï¿½ï¿½Ìºï¿?n\n\nglobal localdrive\nlocaldrive = 'D' # 'D', 'E', 'Y'\n\n\n#buttonlabel = 'scenes' # 'movies'\n\n\n#'Z:/Projects/rise/dev/shots/9999/0010/anim/polishing/maya/scenes/'\n\n\n#'%s:/Projects/%s/dev/shots/%s/%s/%s/%s/maya/%s/'%(localdrive,proje
ctname,filenames[0],filenames[1],filenames[2],filenames[3],buttonlabel)\n\n\n\n'''\ndef localdriveset():\n    #localdrive = localdrive\n    global localdrive\n    if not localdrive == 'Z' :\n        localdrive = 'Z'\n    else :\n        localdrive = 'D'\n    return localdrive\n'''\n\n\n\n\ndef openfolder(buttonlabel):\n    dir = '%s:/Projects/%s/dev/shots/%s/%s/%s/%s/maya/%s/'%(setdrive,projectname,filenames[0],filenames[1],filenames[2],filenames[3],buttonlabel)\n    if not glob.glob(dir):\n        print dir\n        print 'non Path'\n    else :\n        os.startfile(dir)\n\n\n\n\n\ndef setprj():    \n    maya_dir = '%s:/Projects/%s/dev/shots/%s/%s/%s/%s/maya'%(setdrive,projectname,filenames[0],filenames[1],filenames[2],filenames[3])\n    #directory = maya_dir\n    def create_folder( directory ):\n        if not os.path.exists( directory ):\n            os.makedirs( directory )\n    \n    create_folder( maya_dir )\n    \n    for file_rule in cmds.workspace(query=True, fileRuleList=Tru
e):    \n        file_rule_dir = cmds.workspace(fileRuleEntry=file_rule)    \n        maya_file_rule_dir = os.path.join( maya_dir, file_rule_dir)    \n        create_folder( maya_file_rule_dir )\n    \n    mel.eval('setProject \\\"' + maya_dir + '\\\"')\n    # // Warning: file: C:/Program Files/Autodesk/Maya2019/scripts/others/setProject.mel line 304: A project definition file (workspace.mel) was not found at location D:/Projects/rise/dev/shots/9999/0010/anim/polishing/maya, a default project definition will be created. // \n    \n    cmds.confirmDialog( title='Confirm', message= ' set project :\\n\\n' + maya_dir , button='OK')\n\n\n\n\n\ndef UI():\n    win = 'openfolder'\n    if cmds.window(win,exists=1) :\n        cmds.deleteUI(win)\n    cmds.window(win,title=\"Open Folder       ( Hangouts : yslee@locus.com )\",widthHeight=(150,200),s=1,tlb=True)\n    cmds.columnLayout(adjustableColumn=1)\n    cmds.text(\"Rise Folder\\nselect drive\",fn=\"fixedWidthFont\",h=30)\n\n\n    cmds.radioCo
llection()\n    cmds.radioButton( label=localdrive , cc = \"setdrive = localdrive \" )\n    cmds.radioButton( label='Z' ,select =1, cc = \"setdrive = 'Z' \" )\n    \n    #cmds.textField('sqnumber', height=30 ,tx='Enter SQ num')\n    #cmds.textField('shotnumber', height=30 ,tx='Enter Shot num')\n    cmds.button(h=35,bgc=(0.7,0.8,0.8),l=\"set project\" ,c=\"setprj()\")\n    cmds.button(h=35,bgc=(0.8,0.8,0.8),l=\"Scene\",c=\"openfolder('scenes')\")\n    cmds.button(h=35,bgc=(0.9,0.8,0.8),l=\"Movies\" ,c=\"openfolder('movies')\")\n    #cmds.button(h=35,bgc=(0.1,0.1,0.1),l=\"Close\",c=\"win='openfolder';cmds.deleteUI(win)\")\n    cmds.showWindow(win)\n\n\n\n\nUI()\n\n" 
