        -sourceType "python" 
        -doubleClickCommand "import imp\nmgMHIKFKMatch = imp.load_source('', 'C:/Users/vivestudios/Documents/maya/2020/scripts/madguru_tools/meta_ikfk_match.py')\nmgMHIKFKMatch.ik_fk_match(start_frame = int(cmds.playbackOptions(q=1,minTime=1)), end_frame = int(cmds.playbackOptions(q=1,maxTime=1)))" 
