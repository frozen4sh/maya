        -enable 1
        -width 35
        -height 34
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "# uncompyle6 version 3.5.0\n# Python bytecode 3.7 (3394)\n# Decompiled from: Python 2.7.5 (default, Nov 16 2020, 22:23:17) \n# [GCC 4.8.5 20150623 (Red Hat 4.8.5-44)]\n# Embedded file name: C:/Users/Abhishek/Documents/maya/2022/scripts\\topoWrap.py\n# Size of source mod 2**32: 60682 bytes  '314257216956563674'\nimport uuid,platform\n\nPCN=platform.node()\nloc = str(uuid.uuid4())\nloc = loc.split('-')\ncmds.optionVar(sv=['sphereAxisModeTW', loc[0]])\ncmds.optionVar(sv=['cubeAxisModeTW', loc[2]])\ncmds.optionVar(sv=['planeAxisModeTW', loc[3]])\ncmds.optionVar(sv=['coneAxisModeTW', loc[1]])\ncmds.optionVar(sv=['cylinderAxisModeTW', PCN])\ncmds.savePrefs()\ncmds.scriptEditorInfo(clearHistory=1)\n#from maya.cmds import cmds\nimport maya.cmds as cmds\n#from maya.mel import mel\nimport maya.mel as mel\nfrom functools import partial\nimport random as rand\nfrom math import *\nimport time\nimport maya.api.OpenMaya as om\n#from pymel.core import core as pm\nimport pymel.core as pm\nimport pymel.core as core\nimport colorsys, json\n\ndef Func1(mode='cust'):\n    networkNodes = cmds.ls(type='network')\n    if networkNodes:\n        for node in networkNodes:\n            if cmds.attributeQuery('isAtrapStripNode', node=node, exists=True):\n                pass\n            if cmds.getAttr(node + '.isAtrapStripNode'):\n                if mode == 'all':\n                    trapStripNodes.append(node)\n            elif mode == 'tras':\n                if cmds.attributeQuery('connectedtrasNode', node=node, exists=True):\n                    trapStripNodes.append(node)\n                elif not cmds.attributeQuery('connectedtrasNode', node=node, exists=True):\n                    trapStripNodes.append(node)\n\n\ndef Func2():\n    return 10\n\n\ndef tuts(*args):\n    import webbrowser\n    webbrowser.open('https://www.youtube.com/playlist?list=PLjdbFNyrLnM1i2jBLtlSnaqKdHr3jM0gE')\n\n\ndef aboutUs(*args):\n    import webbrowser\n    webbrowser.open('https://www.facebook.com/UnPlugTools')\n\n\ndef otherProducts(*args):\n    import webbrowser\n    webbrowser.open('https://gumroad.com/unplugtools')\n\n\ndef bakeTex(selectedMenuItem, *args):\n    try:\n        res = cmds.optionMenu(selectedMenuItem, query=True, value=True)\n        res = int(res)\n        initialTime = time.time()\n        sel = cmds.ls(sl=1)\n        if len(sel) != 1:\n            cmds.warning('Please select one Valid Retopo-mesh for Texture Baking')\n        if len(sel) == 1:\n            progres = cmds.window(t=' Texture Baking in Progress ')\n            cmds.columnLayout()\n            progressControl = cmds.progressBar(width=380)\n            cmds.showWindow(progres)\n            progressInc = cmds.progressBar(progressControl, edit=True, pr=0)\n            sel = cmds.ls(sl=1)[0]\n            vs = cmds.getAttr(sel + '.visibility')\n            if vs == 0:\n                cmds.setAttr(sel + '.visibility', 1)\n            cmds.select(topoSetup)\n            loadSetup()\n            cmds.select(cl=1)\n            bb = cmds.xform(sel, bb=1, q=1)\n            wd = bb[3] - bb[0]\n            ht = bb[4] - bb[1]\n            ln = bb[5] - bb[2]\n            avg = (ln + wd + ht) / 3\n            val = 0.01\n            dup = cmds.duplicate(sel)[0]\n            cmds.displaySmoothness(divisionsU=0, divisionsV=0, pointsWire=4, pointsShaded=1, polygonObject=1)\n            cmds.polySmooth(dup, mth=0, sdt=0, ovb=1, ofb=3, ofc=0, ost=0, ocr=0, dv=1, bnr=1, c=1,\n              kb=0,\n              ksb=0,\n              khe=0,\n              kt=1,\n              kmb=1,\n              suv=1,\n              peh=0,\n              sl=1,\n              dpe=1,\n              ps=0.1,\n              ro=1,\n              ch=0)\n            progressInc = cmds.progressBar(progressControl, edit=True, pr=10)\n            cmds.select(dup, mb)\n            cmds.CreateShrinkWrap()\n            shp = cmds.listRelatives(s=1)[0]\n            shwrp = cmds.listConnections(shp, type='shrinkWrap')[0]\n            cmds.setAttr(shwrp + '.projection', 4)\n            cmds.select(cl=1)\n            cmds.delete(dup, ch=1)\n            progressInc = cmds.progressBar(progressControl, edit=True, pr=50)\n            tifBakePath = cmds.workspace(q=1, rd=1) + 'sourceimages/'\n            fileN = tifBakePath + sel + '_topoWrapTex'\n            print(fileN)\n            cmds.surfaceSampler(mo='diffuseRGB', fn=fileN, ff='tif', s=mb, t=dup,\n              uv='map1',\n              mw=res,\n              mh=res,\n              ss=0,\n              so=0,\n              msd=(avg * val * 1.1),\n              max=1,\n              sp='tangent',\n              mm=1,\n              sh=1,\n              ft=0,\n              fs=1,\n              os=1,\n              sm=1,\n              ugn=1,\n              imf=0,\n              fu=0,\n              fv=0)\n            finalTime = time.time()\n            TotalTime = finalTime - initialTime\n            TotalTime = round(TotalTime, 2)\n            progressInc = cmds.progressBar(progressControl, edit=True, pr=100)\n            cmds.deleteUI(progres)\n            cmds.warning('Tex Baking done- Time Taken: ' + str(TotalTime) + ' secs --- Texture Path:  ' + tifBakePath + fileN + '.tif')\n            cmds.select(sel)\n            if vs == 0:\n                cmds.setAttr(sel + '.visibility', 0)\n            cmds.delete(dup)\n    except:\n        cmds.warning('No Valid Retopo Setup Loaded')\n\n\ndef toggleBallPnts(*args):\n    try:\n        cmds.select(topoSetup)\n        loadSetup()\n        elems = cmds.listRelatives(c=1)\n        cmds.select(cl=1)\n        pntsA = len(elems) == 6 and cmds.listRelatives(ga, c=1, pa=1)\n        pntsB = cmds.listRelatives(gb, c=1, pa=1)\n        if pntsA == None:\n            if pntsB == None:\n                cmds.warning('No Topo-Points found in the Setup')\n            else:\n                sphA = []\n                sphB = []\n                for e, f in zip(pntsA, pntsB):\n                    posA = cmds.xform(e, t=1, q=1, ws=1)\n                    posB = cmds.xform(f, t=1, q=1, ws=1)\n                    rad = float(cmds.getAttr(elems[4] + '.scl')) / 150\n                    s = cmds.sphere(r=rad)[0]\n                    cmds.setAttr(s + '.overrideEnabled', 1)\n                    cmds.setAttr(s + '.overrideDisplayType', 2)\n                    sphA.append(s)\n                    cmds.xform(s, t=posA, ws=1)\n                    rad = float(cmds.getAttr(elems[5] + '.scl')) / 150\n                    s = cmds.sphere(r=rad)[0]\n                    cmds.setAttr(s + '.overrideEnabled', 1)\n                    cmds.setAttr(s + '.overrideDisplayType', 2)\n                    sphB.append(s)\n                    cmds.xform(s, t=posB, ws=1)\n\n                grpA = cmds.group(sphA, n='markGeoA')\n                cmds.hyperShade(assign=(lam3[0]))\n                cmds.parent(grpA, topoSetup)\n                grpB = cmds.group(sphB, n='markGeoB')\n                cmds.hyperShade(assign=(lam4[0]))\n                cmds.parent(grpB, topoSetup)\n                cmds.select(cl=1)\n                cmds.warning('Geo Markers ON')\n            if len(elems) > 6:\n                cmds.delete(elems[6], elems[7])\n                cmds.warning('Geo Markers OFF')\n    except:\n        cmds.warning('No Valid Retopo Setup Loaded')\n\n\ndef snapMarkers(*args):\n    try:\n        cmds.select(topoSetup)\n        loadSetup()\n        cmds.select(cl=1)\n        cmds.warning('Markers Snapping in Progress')\n        CPOM1 = cmds.createNode('closestPointOnMesh')\n        cmds.connectAttr(ma + '.worldMatrix', CPOM1 + '.inputMatrix')\n        cmds.connectAttr(ma + '.worldMesh', CPOM1 + '.inMesh')\n        CPOM2 = cmds.createNode('closestPointOnMesh')\n        cmds.connectAttr(mb + '.worldMatrix', CPOM2 + '.inputMatrix')\n        cmds.connectAttr(mb + '.worldMesh', CPOM2 + '.inMesh')\n        pntsA = cmds.listRelatives(ga, c=1, pa=1)\n        pntsB = cmds.listRelatives(gb, c=1, pa=1)\n        if pntsA == None:\n            if pntsB == None:\n                cmds.warning('No Topo-Points found in the Setup')\n            else:\n                x = len(pntsB)\n                window = cmds.window(t='Markers Snapping Progress')\n                cmds.columnLayout()\n                progressControl = cmds.progressBar(maxValue=x, width=300)\n                cmds.showWindow(window)\n                p = 0\n                for e, f in zip(pntsA, pntsB):\n                    posA = cmds.xform(e, t=1, q=1, ws=1)\n                    cmds.setAttr(CPOM1 + '.inPositionX', posA[0])\n                    cmds.setAttr(CPOM1 + '.inPositionY', posA[1])\n                    cmds.setAttr(CPOM1 + '.inPositionZ', posA[2])\n                    newPosA = cmds.getAttr(CPOM1 + '.p')[0]\n                    cmds.lockNode(e, lock=0)\n                    unlockT(e)\n                    cmds.xform(e, t=newPosA, ws=1)\n                    lockT(e)\n                    cmds.lockNode(e, lock=1)\n                    posB = cmds.xform(f, t=1, q=1, ws=1)\n                    cmds.setAttr(CPOM2 + '.inPositionX', posB[0])\n                    cmds.setAttr(CPOM2 + '.inPositionY', posB[1])\n                    cmds.setAttr(CPOM2 + '.inPositionZ', posB[2])\n                    newPosB = cmds.getAttr(CPOM2 + '.p')[0]\n                    x1 = str(posB[0])\n                    x1 = float(x1[0:8])\n                    x2 = str(newPosB[0])\n                    x2 = float(x2[0:8])\n                    y1 = str(posB[1])\n                    y1 = float(y1[0:8])\n                    y2 = str(newPosB[1])\n                    y2 = float(y2[0:8])\n                    z1 = str(posB[2])\n                    z1 = float(z1[0:8])\n                    z2 = str(newPosB[2])\n                    z2 = float(z2[0:8])\n                    if x1 != x2:\n                        pass\n                    if y1 != y2:\n                        if z1 != z2:\n                            cmds.lockNode(f, lock=0)\n                            unlockT(f)\n                            cmds.xform(f, t=newPosB, ws=1)\n                            lockT(f)\n                            cmds.lockNode(f, lock=1)\n                        progressInc = cmds.progressBar(progressControl, edit=True, pr=p)\n                        p = p + 1\n\n            cmds.delete(CPOM1, CPOM2)\n            cmds.deleteUI(window)\n            cmds.warning('Markers Snapping Complete')\n    except:\n        cmds.warning('No Valid Retopo Setup Loaded')\n\n\ndef exportPoints(*args):\n    global posAs\n    global posBs\n    try:\n        cmds.select(topoSetup)\n        loadSetup()\n        cmds.select(cl=1)\n        pntsA = cmds.listRelatives(ga, c=1, pa=1)\n        pntsB = cmds.listRelatives(gb, c=1, pa=1)\n        if pntsA == None:\n            if pntsB == None:\n                cmds.warning('No Topo-Points found in the Setup')\n        else:\n            posAs = []\n            posBs = []\n            for e, f in zip(pntsA, pntsB):\n                posA = cmds.xform(e, t=1, q=1, ws=1)\n                posB = cmds.xform(f, t=1, q=1, ws=1)\n                posAs.append(posA)\n                posBs.append(posB)\n\n            PntsPosPair = (\n             posAs, posBs)\n            PntsPosPair = json.dumps(PntsPosPair)\n            savePath = cmds.fileDialog2(fileFilter='*.marks', dialogStyle=2)\n            f = open(savePath[0], 'w+')\n            f.write(PntsPosPair)\n            f.close()\n    except:\n        cmds.warning('No Valid Retopo Setup Loaded')\n\n\ndef importPoints(*args):\n    try:\n        cmds.select(topoSetup)\n        loadSetup()\n        cmds.select(cl=1)\n        pntsA = cmds.listRelatives(ga, c=1, pa=1)\n        pntsB = cmds.listRelatives(gb, c=1, pa=1)\n        if ga == None:\n            if gb == None:\n                cmds.warning('No Topo-Points found in the Setup')\n        elif pntsA != None:\n            cmds.warning('The Setup already got Points')\n        else:\n            if pntsA == None:\n                loadPath = cmds.fileDialog()\n                load = open(loadPath, 'r')\n                PntsPosPair = load.read()\n                PntsPosPair = json.loads(PntsPosPair)\n                c = 1\n                for ps in PntsPosPair:\n                    cnt = 1\n                    for e in ps:\n                        s = cmds.sphere(r=0.01)[0]\n                        cmds.xform(s, t=e, ws=1)\n                        an = cmds.annotate(s, p=(e[0], e[1], e[2]))\n                        cmds.pickWalk(d='up')\n                        an = cmds.ls(sl=1)[0]\n                        cmds.delete(s)\n                        cmds.setAttr(an + '.displayArrow', 0)\n                        cmds.setAttr((an + '.text'), cnt, type='string')\n                        cmds.setAttr(an + '.overrideEnabled', 1)\n                        cmds.setAttr(an + '.overrideRGBColors', 1)\n                        if c == 1:\n                            cmds.setAttr(an + '.overrideColorRGB', 1, 0, 0)\n                        if c == 2:\n                            cmds.setAttr(an + '.overrideColorRGB', 0, 1, 0)\n                        cmds.select(an)\n                        if c == 1:\n                            cmds.rename('markerA_' + str(cnt))\n                        if c == 2:\n                            cmds.rename('markerB_' + str(cnt))\n                        an = cmds.ls(sl=1)[0]\n                        cnt += 1\n                        lockT(an)\n                        ann = pm.ls(sl=1)\n                        if c == 1:\n                            cmds.parent(an, ga)\n                        if c == 2:\n                            cmds.parent(an, gb)\n                        pm.lockNode(ann)\n                        cmds.select(cl=1)\n\n                    c += 1\n\n    except:\n        cmds.warning('No Valid Retopo Setup Loaded')\n\n\ndef hideUnhidePnts(*args):\n    try:\n        cmds.select(topoSetup)\n        loadSetup()\n        cmds.select(cl=1)\n        pntsA = cmds.listRelatives(ga, c=1, pa=1)\n        pntsB = cmds.listRelatives(gb, c=1, pa=1)\n        if pntsA == None:\n            cmds.warning('No Topo-Points found in the Setup')\n        else:\n            hq = cmds.getAttr(pntsA[0] + '.visibility')\n            for e, f in zip(pntsA, pntsB):\n                if hq == True:\n                    cmds.setAttr(e + '.visibility', 0)\n                    cmds.setAttr(f + '.visibility', 0)\n                    cmds.warning('Show - OFF')\n                if hq == False:\n                    cmds.setAttr(e + '.visibility', 1)\n                    cmds.setAttr(f + '.visibility', 1)\n                    cmds.warning('Show - ON')\n\n    except:\n        cmds.warning('No Valid Retopo Setup Loaded')\n\n\ndef deleteSetup(*args):\n    try:\n        cmds.select(topoSetup)\n        loadSetup()\n        pntsA = cmds.listRelatives(ga, c=1, pa=1)\n        pntsB = cmds.listRelatives(gb, c=1, pa=1)\n        try:\n            for e in pntsA:\n                cmds.lockNode(e, lock=0)\n\n            for e in pntsB:\n                cmds.lockNode(e, lock=0)\n\n        except:\n            pass\n\n        cmds.lockNode(ma, lock=0)\n        cmds.lockNode(mb, lock=0)\n        unlockT(ma)\n        unlockT(mb)\n        cmds.select(ga)\n        cmds.pickWalk(d='up')\n        cmds.delete()\n        cmds.warning('Retopo Setup Deleted')\n    except:\n        cmds.warning('No Retopo Setup Found')\n\n\ndef loadSetup(*args):\n    global ga\n    global gb\n    global lam1\n    global lam2\n    global lam3\n    global lam4\n    global ma\n    global mb\n    global topoSetup\n    sell = cmds.ls(sl=1, l=1)\n    topoSetup = cmds.ls(sl=1, l=1)\n    if len(sell) == 0:\n        cmds.warning('Please Select A Retopo Setup to Load')\n    else:\n        try:\n            sel = cmds.listRelatives(sell, c=1, pa=1)\n            ga = sel[0]\n            gas = ga.split('|')\n            if len(gas) > 1:\n                ga = gas[(len(gas) - 1)]\n            if ga != 'markers_A_grp':\n                cmds.warning('Please Select B Valid Retopo Setup to Load')\n            else:\n                gb = sel[1]\n                ma = sel[2]\n                mb = sel[3]\n                shp = cmds.listRelatives(ma, pa=1)[0]\n                lc = cmds.listConnections(shp)\n                lam1 = cmds.listConnections(lc, type='lambert')[0]\n                shp = cmds.listRelatives(mb, pa=1)[0]\n                lc = cmds.listConnections(shp)\n                lam2 = cmds.listConnections(lc, type='lambert')[0]\n                lam3 = cmds.ls('markerAColor')\n                lam4 = cmds.ls('markerBColor')\n                cmds.warning(' Retopo Setup Loadaded')\n        except:\n            cmds.warning('Please Select C Valid Retopo Setup to Load')\n\n\ndef createExcludeSet(*args):\n    global excludeSet\n    sel = cmds.ls(sl=1, fl=1)\n    if len(sel) == 0:\n        cmds.warning('Please Select some Vertices to Exclude from Snap')\n    else:\n        try:\n            vtx = sel[0].split('[')[0]\n            vtxN = vtx.split('.')[1]\n            if vtxN == 'vtx':\n                excludeSet = cmds.sets(n='excludeSet')\n            else:\n                cmds.warning('Please Select some Vertices to Exclude from Snap')\n        except:\n            cmds.warning('Please Select some Vertices to Exclude from Snap')\n\n\ndef toggleRefMode(*args):\n    try:\n        cmds.select(topoSetup)\n        loadSetup()\n        cmds.select(cl=1)\n        ord = cmds.getAttr(ma + '.overrideEnabled')\n        if ord == 1:\n            cmds.setAttr(ma + '.overrideEnabled', 0)\n            cmds.setAttr(mb + '.overrideEnabled', 0)\n            cmds.warning('Set to Normal Select Mode')\n        if ord == 0:\n            cmds.setAttr(ma + '.overrideEnabled', 1)\n            cmds.setAttr(mb + '.overrideEnabled', 1)\n            cmds.warning('Set to Reference Mode')\n    except:\n        cmds.warning('No Retopo Setup Found')\n\n\ndef createSetup(*args):\n    global ga\n    global gb\n    global lam1\n    global lam2\n    global lam3\n    global lam4\n    global ma\n    global mb\n    global topoSetup\n    sell = cmds.ls(sl=1)\n    if len(sell) == 2:\n        sel = cmds.duplicate(sell)\n        cmds.hide(sell)\n        pls = []\n        for e in sel:\n            cmds.setAttr(e + '.overrideEnabled', 1)\n            cmds.setAttr(e + '.overrideDisplayType', 2)\n            bb = cmds.xform(e, bb=1, q=1)\n            cntr = cmds.objectCenter(e, gl=1)\n            ln = bb[4] - bb[1]\n            ht = bb[5] - bb[2]\n            pl = cmds.polyPlane(w=(ln * 1.2), h=(ht * 1.2), n='axisRef_01')[0]\n            cmds.addAttr(pl, ln='scl', dt='string')\n            cmds.setAttr((pl + '.scl'), ht, type='string', l=1)\n            pls.append(pl)\n            shp = cmds.listRelatives(pl, s=1, pa=1)[0]\n            cmds.setAttr(shp + '.template', 1)\n            cmds.rotate(0, 0, 90)\n            cmds.move(cntr[0], cntr[1], cntr[2])\n            cmds.makeIdentity(apply=1, t=1, r=1, s=1, n=0, pn=1)\n            cmds.delete(ch=1)\n\n        topoSetup = cmds.group(em=1, n='Retop_Setup_01')\n        ga = cmds.group(em=1, n='markers_A_grp')\n        gb = cmds.group(em=1, n='markers_B_grp')\n        cmds.parent(ga, gb, topoSetup)\n        cmds.parent(sel, topoSetup)\n        cmds.parent(pls, topoSetup)\n        sel = cmds.listRelatives(topoSetup, c=1, pa=1)\n        ga = sel[0]\n        gb = sel[1]\n        ma = sel[2]\n        mb = sel[3]\n        lockT(sel[2])\n        lockT(sel[3])\n        cmds.lockNode(ma)\n        cmds.lockNode(mb)\n        lam1 = cmds.shadingNode('lambert', asShader=1, n='BaseTopoColor')\n        lam2 = cmds.shadingNode('lambert', asShader=1, n='RawModelColor')\n        lam3 = cmds.shadingNode('lambert', asShader=1, n='markerAColor')\n        lam4 = cmds.shadingNode('lambert', asShader=1, n='markerBColor')\n        cmds.setAttr((lam3 + '.color'), 1, 0, 0, type='double3')\n        cmds.setAttr((lam4 + '.color'), 0, 1, 0, type='double3')\n        cmds.select(ma)\n        cmds.hyperShade(assign=lam1)\n        cmds.select(mb)\n        cmds.hyperShade(assign=lam2)\n        cmds.select(cl=1)\n    else:\n        cmds.warning('Please Select 2 meshes: a Source and a Target Mesh')\n\n\ndef tweakPointsA(*args):\n    try:\n        lamCol1 = cmds.getAttr(lam1 + '.color')\n        lamCol2 = cmds.getAttr(lam2 + '.color')\n        if lamCol1[0][0] == 0.5:\n            exitTweakPoints()\n            sel = cmds.ls(sl=1)\n            pntsA = cmds.listRelatives(ga, c=1, pa=1)\n            for e in pntsA:\n                cmds.lockNode(e, lock=0)\n                unlockT(e)\n                cmds.lockNode(e, lock=1)\n\n            cmds.setAttr((lam1 + '.color'), 0.2, 0.3, 0.5, type='double3')\n            cmds.setAttr((lam2 + '.color'), 0.5, 0.5, 0.5, type='double3')\n            cmds.setToolTo('Move')\n            cmds.select(ma)\n            cmds.makeLive()\n            cmds.select(sel)\n        else:\n            exitTweakPoints()\n    except:\n        cmds.warning('No Valid Retopo Setup Found')\n\n\ndef tweakPointsB(*args):\n    try:\n        lamCol1 = cmds.getAttr(lam1 + '.color')\n        lamCol2 = cmds.getAttr(lam2 + '.color')\n        if lamCol2[0][0] == 0.5:\n            exitTweakPoints()\n            sel = cmds.ls(sl=1)\n            pntsB = cmds.listRelatives(gb, c=1, pa=1)\n            for e in pntsB:\n                cmds.lockNode(e, lock=0)\n                unlockT(e)\n                cmds.lockNode(e, lock=1)\n\n            cmds.setAttr((lam2 + '.color'), 0.2, 0.3, 0.5, type='double3')\n            cmds.setAttr((lam1 + '.color'), 0.5, 0.5, 0.5, type='double3')\n            cmds.setToolTo('Move')\n            cmds.select(mb)\n            cmds.makeLive()\n            cmds.select(sel)\n        else:\n            exitTweakPoints()\n    except:\n        cmds.warning('No Valid Retopo Setup Found')\n\n\ndef paintRelax(*args):\n    sel = cmds.ls(sl=1)\n    if len(sel) == 0:\n        cmds.warning('Please Select a Mesh to Relax')\n    else:\n        cmds.SculptGeometryTool()\n        try:\n            cmds.artPuttyCtx('artPuttyContext')\n        except:\n            pass\n\n        cmds.setToolTo('artPuttyContext')\n        cmds.toolPropertyWindow()\n        mel.eval('artPuttyCtx -e -opacity 0.002 `currentCtx`')\n        mel.eval('artPuttyCtx -e -reflection  true `currentCtx`')\n        cmds.stackTrace(state=0)\n        mel.eval('artUpdatePuttyOperation artPuttyCtx relax ')\n        cmds.stackTrace(state=1)\n        cmds.scriptEditorInfo(clearHistory=True)\n\n\ndef exitTweakPoints(*args):\n    sel = cmds.ls(sl=1)\n    pntsA = cmds.listRelatives(ga, c=1, pa=1)\n    pntsB = cmds.listRelatives(gb, c=1, pa=1)\n    try:\n        for e in pntsA:\n            cmds.lockNode(e, lock=0)\n            lockT(e)\n            cmds.lockNode(e, lock=1)\n\n    except:\n        pass\n\n    try:\n        for e in pntsB:\n            cmds.lockNode(e, lock=0)\n            lockT(e)\n            cmds.lockNode(e, lock=1)\n\n    except:\n        pass\n\n    cmds.setAttr((lam1 + '.color'), 0.5, 0.5, 0.5, type='double3')\n    cmds.setAttr((lam2 + '.color'), 0.5, 0.5, 0.5, type='double3')\n    cmds.select(cl=1)\n    cmds.makeLive()\n    cmds.select(sel)\n\n\ndef deletePoints(*args):\n    sel = cmds.ls(sl=1)\n    if len(sel) == 0:\n        cmds.warning('Please Select Marker-Points to delete')\n    else:\n        try:\n            pntsA = cmds.listRelatives(ga, c=1, pa=1)\n            sell = []\n            for e in sel:\n                lr = cmds.listRelatives(e, c=1, pa=1)\n                typ = cmds.objectType(lr)\n                if typ == 'annotationShape':\n                    sell.append(e)\n                pntsA = cmds.listRelatives(ga, c=1, pa=1)\n                pntsB = cmds.listRelatives(gb, c=1, pa=1)\n                for sl in sell:\n                    for e, f in zip(pntsA, pntsB):\n                        if sl == e or sl == f:\n                            cmds.lockNode(e, lock=0)\n                            cmds.lockNode(f, lock=0)\n                            cmds.delete(e, f)\n\n                    try:\n                        cmds.delete(sl)\n                    except:\n                        pass\n\n                pntsA = cmds.listRelatives(ga, c=1, pa=1)\n                pntsB = cmds.listRelatives(gb, c=1, pa=1)\n                ct = 1\n                try:\n                    for e, f in zip(pntsA, pntsB):\n                        cmds.setAttr((e + '.text'), ct, type='string')\n                        cmds.setAttr((f + '.text'), ct, type='string')\n                        ct += 1\n\n                except:\n                    pass\n\n                cmds.select(cl=1)\n\n        except:\n            cmds.warning('No Valid Retopo Setup found')\n\n\ndef mirrorPoints(*args):\n    try:\n        sel = cmds.ls(sl=1)\n        cmds.select(topoSetup)\n        loadSetup()\n        cmds.warning('Done')\n        cmds.select(sel)\n        if len(sel) > 0:\n            pntsA = cmds.listRelatives(ga, c=1, pa=1)\n            pntsB = cmds.listRelatives(gb, c=1, pa=1)\n            lenPnt = len(pntsB)\n            try:\n                cmds.lockNode((pntsA[lenPnt]), lock=0)\n                cmds.delete(pntsA[lenPnt])\n                pntsA = cmds.listRelatives(ga, c=1, pa=1)\n                pntsB = cmds.listRelatives(gb, c=1, pa=1)\n            except:\n                pass\n\n            dupPntsA = []\n            dupPntsB = []\n            for sl in sel:\n                for e, f in zip(pntsA, pntsB):\n                    if sl == e or sl == f:\n                        d = cmds.duplicate(e)[0]\n                        dupPntsA.append(d)\n                        d = cmds.duplicate(f)[0]\n                        dupPntsB.append(d)\n\n        else:\n            pntsA = cmds.listRelatives(ga, c=1, pa=1)\n            pntsB = cmds.listRelatives(gb, c=1, pa=1)\n            if pntsB == None:\n                cmds.warning('No Topo-Points found for Mirroring')\n            else:\n                lenPnt = len(pntsB)\n                try:\n                    cmds.lockNode((pntsA[lenPnt]), lock=0)\n                    cmds.delete(pntsA[lenPnt])\n                    pntsA = cmds.listRelatives(ga, c=1, pa=1)\n                    pntsB = cmds.listRelatives(gb, c=1, pa=1)\n                except:\n                    pass\n\n                pntsAB = (\n                 pntsA, pntsB)\n                for ee in pntsAB:\n                    pv = [\n                     'a']\n                    ng = ['a']\n                    for e in ee:\n                        p = cmds.xform(e, t=1, ws=1, q=1)[0]\n                        pe = [p, e]\n                        if p < 0:\n                            ng.append(pe)\n                        else:\n                            pv.append(pe)\n\n                    xxx = [\n                     [\n                      len(pv), pv], [len(ng), ng]]\n                    xxx.sort()\n                    for e in xxx[0][1]:\n                        try:\n                            cmds.lockNode((e[1]), lock=0)\n                            cmds.delete(e[1])\n                        except:\n                            pass\n\n                pntsA = cmds.listRelatives(ga, c=1, pa=1)\n                pntsB = cmds.listRelatives(gb, c=1, pa=1)\n                dupPntsA = cmds.duplicate(pntsA)\n                dupPntsB = cmds.duplicate(pntsB)\n        if pntsA == None:\n            cmds.warning('No Topo-Points found for Mirroring')\n        else:\n            for e, f in zip(dupPntsA, dupPntsB):\n                unlockT(e)\n                unlockT(f)\n                vl = cmds.getAttr(e + '.translateX')\n                cmds.setAttr(e + '.translateX', -vl)\n                vl = cmds.getAttr(f + '.translateX')\n                cmds.setAttr(f + '.translateX', -vl)\n                lockT(e)\n                lockT(f)\n                cmds.lockNode(e)\n                cmds.lockNode(f)\n\n            pntsA = cmds.listRelatives(ga, c=1)\n            pntsB = cmds.listRelatives(gb, c=1)\n            ct = 1\n            for e, f in zip(pntsA, pntsB):\n                cmds.setAttr((e + '.text'), ct, type='string')\n                cmds.setAttr((f + '.text'), ct, type='string')\n                ct += 1\n\n    except:\n        cmds.warning('No Valid Retopo Setup or Points Found')\n\n\ndef drawPoints(*args):\n    try:\n        cmds.select(topoSetup)\n        loadSetup()\n        cmds.warning('Tip: Draw your Topo-Points Alternately on your Source & Target meshes')\n        cmds.jointDisplayScale(0.2)\n        pntsA = cmds.listRelatives(ga, c=1, pa=1)\n        pntsB = cmds.listRelatives(gb, c=1, pa=1)\n        if pntsA == None:\n            pntsA = 0\n        else:\n            pntsA = len(pntsA)\n        if pntsB == None:\n            pntsB = 0\n        else:\n            pntsB = len(pntsB)\n        if pntsA > pntsB:\n            live = mb\n        if pntsA == pntsB:\n            live = ma\n        cmds.select(live)\n        shp = cmds.listRelatives(live)[0]\n        lc = cmds.listConnections(shp)\n        lam = cmds.listConnections(lc, type='lambert')[0]\n        cmds.setAttr((lam + '.color'), 0.2, 0.4, 0.4, type='double3')\n        cmds.makeLive()\n        cmds.JointTool()\n        cmds.scriptJob(event=['DagObjectCreated', 'setPntsJb()'], compressUndo=True)\n        cmds.scriptJob(event=['ToolChanged', 'kldrwJb()'], runOnce=True)\n    except:\n        cmds.warning('No Valid Retopo Setup Found')\n\n\ndef lockT(an):\n    cmds.setAttr((an + '.tx'), lock=1)\n    cmds.setAttr((an + '.ty'), lock=1)\n    cmds.setAttr((an + '.tz'), lock=1)\n    cmds.setAttr((an + '.rx'), lock=1)\n    cmds.setAttr((an + '.ry'), lock=1)\n    cmds.setAttr((an + '.rz'), lock=1)\n    cmds.setAttr((an + '.sx'), lock=1)\n    cmds.setAttr((an + '.sy'), lock=1)\n    cmds.setAttr((an + '.sz'), lock=1)\n\n\ndef unlockT(an):\n    cmds.setAttr((an + '.tx'), lock=0)\n    cmds.setAttr((an + '.ty'), lock=0)\n    cmds.setAttr((an + '.tz'), lock=0)\n    cmds.setAttr((an + '.rx'), lock=0)\n    cmds.setAttr((an + '.ry'), lock=0)\n    cmds.setAttr((an + '.rz'), lock=0)\n    cmds.setAttr((an + '.sx'), lock=0)\n    cmds.setAttr((an + '.sy'), lock=0)\n    cmds.setAttr((an + '.sz'), lock=0)\n\n\ndef setPntsJb(*args):\n    global an2\n    pntsA = cmds.listRelatives(ga, c=1)\n    pntsB = cmds.listRelatives(gb, c=1)\n    if pntsA == None:\n        pntsA = 0\n    else:\n        pntsA = len(pntsA)\n    if pntsB == None:\n        pntsB = 0\n    else:\n        pntsB = len(pntsB)\n    if pntsA > pntsB:\n        cnt = 0\n    if pntsA == pntsB:\n        cnt = 1\n    jt = cmds.ls(sl=1)[0]\n    cmds.setAttr(jt + '.radius', 0.01)\n    p = cmds.xform(jt, t=1, ws=1, q=1)\n    s = cmds.sphere(r=0.01)[0]\n    cmds.xform(s, t=p, ws=1)\n    an = cmds.annotate(s, p=(p[0], p[1], p[2]))\n    cmds.pickWalk(d='up')\n    an = cmds.ls(sl=1)[0]\n    cmds.delete(jt, s)\n    if cnt % 2 != 0:\n        cmds.setAttr((lam2 + '.color'), 0.2, 0.4, 0.4, type='double3')\n        cmds.setAttr((lam1 + '.color'), 0.5, 0.5, 0.5, type='double3')\n        cmds.setAttr(an + '.displayArrow', 0)\n        cmds.setAttr((an + '.text'), (pntsA + 1), type='string')\n        cmds.setAttr(an + '.overrideEnabled', 1)\n        cmds.setAttr(an + '.overrideRGBColors', 1)\n        cmds.setAttr(an + '.overrideColorRGB', 1, 1, 0)\n        cmds.select(an)\n        cmds.rename('markerA_' + str(pntsA + 1))\n        an = cmds.ls(sl=1)[0]\n        lockT(an)\n        ann = pm.ls(sl=1)\n        an2 = pm.ls(sl=1)[0]\n        cmds.parent(an, ga)\n        pm.lockNode(ann)\n        cmds.select(cl=1)\n        cmds.makeLive()\n        live = mb\n        cmds.select(live)\n        cmds.makeLive()\n        live = mb\n    if cnt % 2 == 0:\n        cmds.setAttr((lam2 + '.color'), 0.5, 0.5, 0.5, type='double3')\n        cmds.setAttr((lam1 + '.color'), 0.2, 0.4, 0.4, type='double3')\n        cmds.setAttr(an + '.displayArrow', 0)\n        cmds.setAttr((an + '.text'), (pntsB + 1), type='string')\n        cmds.setAttr(an + '.overrideEnabled', 1)\n        cmds.setAttr(an + '.overrideRGBColors', 1)\n        cmds.setAttr(an + '.overrideColorRGB', 0, 1, 0)\n        try:\n            pm.setAttr(an2 + '.overrideColorRGB', 1, 0, 0)\n        except:\n            pass\n\n        cmds.select(an)\n        cmds.rename('markerB_' + str(pntsB + 1))\n        an = cmds.ls(sl=1)[0]\n        lockT(an)\n        ann = pm.ls(sl=1)\n        cmds.parent(an, gb)\n        pm.lockNode(ann)\n        cmds.select(cl=1)\n        cmds.makeLive()\n        live = ma\n        cmds.select(live)\n        cmds.makeLive()\n        live = ma\n    cmds.scriptEditorInfo(clearHistory=1)\n\n\ndef kldrwJb(*args):\n    all = cmds.scriptJob(lj=True)\n    for a in all:\n        if 'setPntsJb' in a:\n            b = int(a.split(':')[0])\n            cmds.scriptJob(kill=(int(a.split(':')[0])))\n            cmds.setAttr((lam1 + '.color'), 0.5, 0.5, 0.5, type='double3')\n            cmds.setAttr((lam2 + '.color'), 0.5, 0.5, 0.5, type='double3')\n            cmds.jointDisplayScale(1)\n            cmds.makeLive()\n\n\ndef snapRetopo(*args):\n    try:\n        cmds.select(topoSetup)\n        loadSetup()\n        cmds.warning('Retopo Mesh Creation in Progress')\n        cmds.select(cl=1)\n        try:\n            pntsA = cmds.listRelatives(ga, c=1, pa=1)\n            pntsB = cmds.listRelatives(gb, c=1, pa=1)\n        except:\n            cmds.warning('Please Create Marker Points')\n\n        if pntsB == None:\n            cmds.warning('Please Create Marker Points')\n        else:\n            lenPnt = len(pntsB)\n            if lenPnt < 4:\n                cmds.warning('Cannot create Retopo Mesh, Please create minimum 4 Marker Points or more')\n            else:\n                progres = cmds.window(t=' Creating Retopo Mesh ')\n                cmds.columnLayout()\n                progressControl = cmds.progressBar(width=380)\n                cmds.showWindow(progres)\n                progressInc = cmds.progressBar(progressControl, edit=True, pr=0)\n                try:\n                    cmds.lockNode((pntsA[lenPnt]), lock=0)\n                    cmds.delete(pntsA[lenPnt])\n                    pntsA = cmds.listRelatives(ga, c=1, pa=1)\n                    pntsB = cmds.listRelatives(gb, c=1, pa=1)\n                except:\n                    pass\n\n                jtsA = []\n                pls = []\n                for e in pntsA:\n                    p = cmds.xform(e, t=1, ws=1, q=1)\n                    cmds.select(cl=1)\n                    jt = cmds.joint(radius=0.01, p=(p[0], p[1], p[2]))\n                    cmds.select(cl=1)\n                    pl = cmds.polyPlane(sx=1, sy=1, w=0.001, h=0.001)[0]\n                    cmds.xform(pl, t=p, ws=1)\n                    pls.append(pl)\n                    jtsA.append(jt)\n\n                progressInc = cmds.progressBar(progressControl, edit=True, pr=10)\n                plsGrp = cmds.group(pls)\n                ptc = cmds.polyUnite(ch=0, n='ptc')[0]\n                lowMesh = cmds.duplicate(ma, n='lowMesh')[0]\n                retopMesh = cmds.duplicate(ma, n='retopMesh_01')[0]\n                cmds.polySmooth(lowMesh, ch=0, dv=1)\n                progressInc = cmds.progressBar(progressControl, edit=True, pr=20)\n                cmds.transferAttributes(ptc, lowMesh, transferPositions=1, transferNormals=0, transferUVs=0, transferColors=0, sampleSpace=0,\n                  sourceUvSpace='map1',\n                  targetUvSpace='map1',\n                  searchMethod=3,\n                  flipUVs=0,\n                  colorBorders=1)\n                progressInc = cmds.progressBar(progressControl, edit=True, pr=40)\n                cmds.polyMergeVertex(lowMesh, d=0.005)\n                progressInc = cmds.progressBar(progressControl, edit=True, pr=60)\n                cmds.delete(lowMesh, ch=1)\n                cmds.delete(ptc)\n                cmds.skinCluster(jtsA, lowMesh)\n                cmds.skinCluster(jtsA, retopMesh)\n                cmds.copySkinWeights(lowMesh, retopMesh, noMirror=1, surfaceAssociation='closestPoint', influenceAssociation='closestJoint')\n                for e, f in zip(jtsA, pntsB):\n                    p = cmds.xform(f, t=1, ws=1, q=1)\n                    cmds.xform(e, t=p, ws=1)\n\n                cmds.select(retopMesh)\n                cmds.CenterPivot()\n                cmds.DeleteHistory()\n                cmds.makeIdentity(apply=1, t=1, r=1, s=1, n=0, pn=1)\n                progressInc = cmds.progressBar(progressControl, edit=True, pr=80)\n                baseWrapMesh = cmds.duplicate(retopMesh, n='baseWrap')\n                cmds.transferAttributes(mb, retopMesh, transferPositions=1, transferNormals=0, transferUVs=0, transferColors=0, sampleSpace=0,\n                  sourceUvSpace='map1',\n                  targetUvSpace='map1',\n                  searchMethod=3,\n                  flipUVs=0,\n                  colorBorders=1)\n                cmds.delete(retopMesh, ch=1)\n                cmds.polyNormalPerVertex(retopMesh, ufn=1)\n                cmds.polySoftEdge(retopMesh, a=180, ch=0)\n                cmds.delete(retopMesh, ch=1)\n                bs = cmds.blendShape(baseWrapMesh, retopMesh, n='shapeBlend', w=[(0, 1)])[0]\n                vcnt = cmds.polyEvaluate(retopMesh, v=1)\n                for e in range(vcnt):\n                    cmds.setAttr(bs + '.inputTarget[' + str(0) + '].inputTargetGroup[0].targetWeights' + '[' + str(e) + ']', 0.0)\n\n                try:\n                    cmds.select('excludeSet')\n                    vcnt = cmds.ls(sl=1, fl=1)\n                    vtxs = []\n                    for e in vcnt:\n                        vtx = e.split('[')[0]\n                        vtxN = vtx.split('.')[0]\n                        if vtxN == ma:\n                            vtxs.append(e)\n\n                    for e in vtxs:\n                        vtxNo = e.split('[')[1]\n                        vtxNo = int(vtxNo.split(']')[0])\n                        cmds.setAttr(bs + '.inputTarget[' + str(0) + '].inputTargetGroup[0].targetWeights' + '[' + str(vtxNo) + ']', 1)\n\n                except:\n                    pass\n\n                cmds.delete(baseWrapMesh)\n                cmds.setAttr(retopMesh + '.overrideEnabled', 0)\n                cmds.select(retopMesh)\n                cmds.hyperShade(assign='lambert1')\n                cmds.parent(w=1)\n                cmds.delete(jtsA, lowMesh)\n                progressInc = cmds.progressBar(progressControl, edit=True, pr=100)\n                cmds.deleteUI(progres)\n    except:\n        cmds.warning('No Valid Retopo Setup Found')\n\n\ndef killruntimeJbs():\n    all = cmds.scriptJob(lj=True)\n    for a in all:\n        if 'kldrwJb' in a:\n            b = int(a.split(':')[0])\n            cmds.scriptJob(kill=(int(a.split(':')[0])))\n\n\ndef paintRetainShape(*args):\n    sel = cmds.ls(sl=1)\n    if len(sel) == 0:\n        cmds.warning('Please Select a Rotopo Mesh to Retain')\n    else:\n        cmds.SculptGeometryTool()\n        try:\n            cmds.artAttrCtx('artAttrBlendShapeContext')\n        except:\n            pass\n\n        cmds.setToolTo('artAttrBlendShapeContext')\n\n\ndef enterLicense(*args):\n\n    def feedLCK():\n        result = cmds.promptDialog(title='Enter your License Key for TopoWrap',\n          message='___________Enter your TopoWrap License Key___________',\n          button=[\n         'OK', 'Cancel'],\n          defaultButton='OK',\n          cancelButton='Cancel',\n          dismissString='Cancel')\n        if result == 'OK':\n            enc = cmds.promptDialog(query=True, text=True)\n            enc = str(enc)\n        try:\n\n            def getCPK():\n                return '314257216956563674'\n\n            import base64\n            key = getCPK().encode('ascii')\n            encB64 = enc.encode('ascii')\n            enc2 = base64.urlsafe_b64decode(encB64)\n            dec = []\n            for i in range(len(enc2)):\n                key_c = key[(i % len(key))]\n                dec_c = (256 + enc2[i] - key_c) % 256\n                dec.append(dec_c)\n\n            message = bytes(dec)\n            message = message.decode('ascii')\n            Lic = ''.join(message)\n            Lic = Lic.split('_')\n            chk1 = cmds.optionVar(q='sphereAxisModeTW')\n            chk2 = cmds.optionVar(q='cubeAxisModeTW')\n            if chk1 == Lic[0]:\n                if chk2 == Lic[1]:\n                    cmds.optionVar(sv=['sphereAxisModeTWR', Lic[0]])\n                    cmds.optionVar(sv=['cubeAxisModeTWR', Lic[2]])\n                    cmds.optionVar(sv=['planeAxisModeTWR', Lic[3]])\n                    cmds.optionVar(sv=['coneAxisModeTWR', Lic[1]])\n                    cmds.savePrefs()\n                    cmds.scriptEditorInfo(clearHistory=1)\n                    cmds.warning('CONGRATS..!! Your TopoWrap License is Activated.. Kindly relaunch the Tool UI')\n            else:\n                cmds.warning('License error: Please Enter Correct License Key')\n        except:\n            cmds.warning('License error: Please Enter Correct License Key')\n\n    exs = cmds.optionVar(ex='sphereAxisModeTWR')\n    if exs == 1:\n        cmds.warning('Your Copy is already Licensed')\n    if exs == 0:\n        import platform\n        OS = platform.system()\n        if OS != 'Windows':\n            feedLCK()\n    if OS == 'Windows':\n        feedLCK()\n\n\ndef getActKey(*args):\n\n    def genActKY():\n        import uuid, platform, base64\n        PCN = platform.node()\n        OSnVer = platform.platform()\n        MayaVer = cmds.about(version=1)\n        ex1 = cmds.optionVar(ex='sphereAxisModeTW')\n        ex2 = cmds.optionVar(ex='cubeAxisModeTW')\n        ex3 = cmds.optionVar(ex='planeAxisModeTW')\n        ex4 = cmds.optionVar(ex='coneAxisModeTW')\n\n        def createKeyWin():\n            msgA = cmds.optionVar(q='sphereAxisModeTW')\n            msgB = cmds.optionVar(q='cubeAxisModeTW')\n            msgC = cmds.optionVar(q='planeAxisModeTW')\n            msgD = cmds.optionVar(q='coneAxisModeTW')\n            message = msgA + '_' + msgB + '_' + msgC + '_' + msgD + '_' + PCN + '_' + OSnVer + '_' + 'Maya' + MayaVer\n\n            def getCPK():\n                return '252403183365734451157'\n\n            enc = []\n            clear = message.encode('ascii')\n            key = getCPK().encode('ascii')\n            for i in range(len(clear)):\n                key_c = key[(i % len(key))]\n                enc_c = (clear[i] + key_c) % 256\n                enc.append(enc_c)\n\n            encB64 = base64.urlsafe_b64encode(bytes(enc))\n            enc = encB64.decode('ascii')\n            cmds.warning('Please Copy your TopoWrap ACTIVATION KEY.. and email it to- unplug.tools@gmail.com')\n            if cmds.window('ETWin', exists=True):\n                cmds.deleteUI('ETWin')\n            cmds.window('ETWin', title='Activation Key for TopoWrap', h=60, w=600)\n            cmds.columnLayout(adj=True)\n            cmds.text(label='Please Copy your TopoWrap ACTIVATION KEY.. and email it to- unplug.tools@gmail.com')\n            cmds.text(label='  ctrl+A then ctrl+C')\n            cmds.text(label='')\n            cmds.textField('licGBTextField', text=enc, ed=False, annotation='(Ctrl+A) (Ctrl+C)')\n            cmds.text(label='')\n            cmds.showWindow('ETWin')\n            cmds.setFocus('licGBTextField')\n            cmds.warning('Your Activation Key is')\n            cmds.warning(enc)\n\n        if ex1 != 1:\n            if ex2 != 1:\n                pass\n        if ex3 != 1:\n            if ex4 != 1:\n                loc = str(uuid.uuid4())\n                loc = loc.split('-')\n                cmds.optionVar(sv=['sphereAxisModeTW', loc[0]])\n                cmds.optionVar(sv=['cubeAxisModeTW', loc[2]])\n                cmds.optionVar(sv=['planeAxisModeTW', loc[3]])\n                cmds.optionVar(sv=['coneAxisModeTW', loc[1]])\n                cmds.optionVar(sv=['cylinderAxisModeTW', PCN])\n                cmds.savePrefs()\n                cmds.scriptEditorInfo(clearHistory=1)\n                createKeyWin()\n            if ex1 == 1:\n                if ex2 == 1:\n                    if ex3 == 1:\n                        pass\n        if ex4 == 1:\n            createKeyWin()\n\n    exs = cmds.optionVar(ex='sphereAxisModeTWR')\n    if exs == 1:\n        cmds.warning('Your TopoWrap Copy is already Licensed')\n    if exs == 0:\n        import platform\n        OS = platform.system()\n        if OS != 'Windows':\n            genActKY()\n    if OS == 'Windows':\n        genActKY()\n\n\ndef removeLicense(*args):\n\n    def remLc():\n        remConfirm = cmds.confirmDialog(title='Confirm', message='Are you sure you want to remove TopoWrap License?', button=['Yes', 'No'], defaultButton='Yes', cancelButton='No', dismissString='No')\n        if remConfirm == 'No':\n            cmds.warning('Relax..Your TopoWrap License has NOT been removed')\n        if remConfirm == 'Yes':\n            reremConfirm = cmds.confirmDialog(title='Confirm', message='Please Re-comfrim..!! Are you sure you want to remove TopoWrap License?', button=['Yes', 'No'], defaultButton='Yes', cancelButton='No', dismissString='No')\n            if reremConfirm == 'No':\n                cmds.warning('Relax..Your TopoWrap License has NOT been removed')\n            if reremConfirm == 'Yes':\n                reeremConfirm = cmds.confirmDialog(title='Confirm', message='FINAL RECONFIRM..!! Your FINALLY SURE you want to REMOVE TopoWrap License?', button=['Yes', 'No'], defaultButton='Yes', cancelButton='No', dismissString='No')\n                if reeremConfirm == 'No':\n                    cmds.warning('Relax..Your TopoWrap License has NOT been removed')\n        if reeremConfirm == 'Yes':\n            cmds.optionVar(sv=['gooh3', 1])\n            cmds.optionVar(remove='sphereAxisModeTW')\n            cmds.optionVar(remove='cubeAxisModeTW')\n            cmds.optionVar(remove='planeAxisModeTW')\n            cmds.optionVar(remove='coneAxisModeTW')\n            cmds.optionVar(remove='sphereAxisModeTWR')\n            cmds.optionVar(remove='cubeAxisModeTWR')\n            cmds.optionVar(remove='planeAxisModeTWR')\n            cmds.optionVar(remove='coneAxisModeTWR')\n            cmds.optionVar(remove='cylinderAxisModeTW')\n            cmds.warning('Your `TopoWrap` License has been successfully REMOVED')\n            cmds.evalDeferred('cmds.quit(f=1)')\n\n    chk1 = cmds.optionVar(ex='sphereAxisModeTWR')\n    if chk1 == 0:\n        cmds.warning('NO LICENSE FOUND..!! Your TopoWrap Product is not Registered yet..!!')\n    if chk1 == 1:\n        import platform\n        OS = platform.system()\n        remLc()\n\n\ndef topoWrapUI():\n    for _editor in cmds.lsUI(editors=True):\n        if not cmds.outlinerEditor(_editor, query=True, exists=True):\n            continue\n        _sel_cmd = cmds.outlinerEditor(_editor, query=True, selectCommand=True)\n        if _sel_cmd:\n            if not _sel_cmd.startswith('<function selCom at '):\n                pass\n            else:\n                cmds.outlinerEditor(_editor, edit=True, selectCommand='print(\"\")')\n\n    windowID = 'TopoWrap'\n    if cmds.window(windowID, exists=True):\n        cmds.deleteUI(windowID)\n    import uuid\n    loc = str(uuid.uuid4())        \n    cmds.window(windowID, title='TopoWrap  V1.0 ', menuBar=1, sizeable=1, resizeToFitChildren=1, w=340, h=800)\n    cmds.menu(label=' HELP..!!', tearOff=1)\n    cmds.menuItem(label='Get your Activation Key', c=(partial(getActKey)))\n    cmds.menuItem(label='Enter your License Key', c=(partial(enterLicense)))\n    cmds.menuItem(label='Videos', c=(partial(tuts)))\n    cmds.menuItem(label='About Us', c=(partial(aboutUs)))\n    cmds.menuItem(label='More Products', c=(partial(otherProducts)))\n    cmds.menuItem(label='[Remove License]', c=(partial(removeLicense)), bld=1)\n    cmds.columnLayout(adjustableColumn=1)\n    cmds.text(label='    TOPO-WRAP - Powered by - UNPLUG TOOLS    ', bgc=(0.35, 0.4,\n                                                                          0.45), h=25)\n    cmds.text(label='     unplug.tools@gmail.com     ', bgc=(0.35, 0.4, 0.45), h=20)\n    cmds.text(label='    ', bgc=(0.35, 0.4, 0.4), h=5)\n    cmds.setParent('..')\n\n    def verifyLic():\n        msgA = cmds.optionVar(q='sphereAxisModeTWR')\n        msgB = cmds.optionVar(q='cubeAxisModeTWR')\n        msgC = cmds.optionVar(q='planeAxisModeTWR')\n        msgD = cmds.optionVar(q='coneAxisModeTWR')\n        import platform\n        PCN = platform.node()\n        try:\n            userL = str(msgA) + '_' + str(msgB) + '_' + str(msgC) + '_' + str(msgD) + '_' + PCN\n        except:\n            cmds.warning('License error Please contact your vendor')\n\n        try:\n            msgA = cmds.optionVar(q='sphereAxisModeTW')\n            msgB = cmds.optionVar(q='cubeAxisModeTW')\n            msgC = cmds.optionVar(q='planeAxisModeTW')\n            msgD = cmds.optionVar(q='coneAxisModeTW')\n            msgE = cmds.optionVar(q='cylinderAxisModeTW')\n            key = str(msgA) + '_' + str(msgC) + '_' + str(msgD) + '_' + str(msgB) + '_' + str(msgE)\n        except:\n            cmds.warning('License error: Please contact your vendor')\n\n        return (\n         key, userL)\n    \"\"\"\n    if verifyLic()[0] != verifyLic()[1]:\n        cmds.window(windowID, e=1, h=340, w=250)\n        cmds.columnLayout(adjustableColumn=1)\n        cmds.text(label='No License Installed in this PC', h=20)\n        cmds.text(label='Click below on <Get your Activation Key>', h=20)\n        cmds.button(label='Get your Activation Key', command=(partial(getActKey)))\n        cmds.text(label='Copy your Unique Activation Key', h=20)\n        cmds.text(label='and mail it to - unplug.tools@gmail.com ', h=20)\n        cmds.text(label='along with your Purchase Receipt ', h=20)\n        cmds.text(label='OR your Purchase email ID ', h=20)\n        cmds.separator(h=10)\n        cmds.text(label='Once you recieve your License Key', h=20)\n        cmds.text(label=' Enter the Key by clicking below ', h=20)\n        cmds.button(label='Enter your License Key', c=(partial(enterLicense)))\n        cmds.separator(h=30)\n        cmds.setParent('..')\n        cmds.showWindow(windowID)\n    \"\"\"        \n    #x = verifyLic()[0] == verifyLic()[1] and 1\n    x = 1\n    if x == 1:\n        cmds.window(windowID, e=1, h=550, w=280)\n        cmds.scrollLayout('scrollLayout')\n        cmds.columnLayout()\n        cmds.frameLayout(label='  TopoWrap ToolSets ', collapsable=0, collapse=0, w=270, bgc=(0.3,\n                                                                                              0.4,\n                                                                                              0.45))\n        cmds.text(l='     Retopo Setup Tools : ', h=30, al='left')\n        cmds.rowColumnLayout(nc=3)\n        cmds.text(l='     ')\n        cmds.rowColumnLayout(nc=3)\n        cmds.button(label='        Create Setup       ', command=(partial(createSetup)))\n        cmds.text(l='  ')\n        cmds.button(label='       Create Retopo      ', command=(partial(snapRetopo)))\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.button(label='Load Setup', command=(partial(loadSetup)))\n        cmds.text(l='  ')\n        cmds.button(label='Delete Setup', command=(partial(deleteSetup)))\n        cmds.setParent(top=1)\n        cmds.text(l='     Create / Edit Marker Points : ', h=30, al='left')\n        cmds.rowColumnLayout(nc=3)\n        cmds.text(l='     ')\n        cmds.rowColumnLayout(nc=3)\n        cmds.button(label='  Draw Topo Marker    ', command=(partial(drawPoints)))\n        cmds.text(l='  ')\n        cmds.button(label='  Mirror Markers  ', command=(partial(mirrorPoints)))\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.button(label='Tweak Markers A', command=(partial(tweakPointsA)))\n        cmds.text(l='  ')\n        cmds.button(label='Tweak Markers B', command=(partial(tweakPointsB)))\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.button(label='  Hide/Show Markers  ', command=(partial(hideUnhidePnts)))\n        cmds.text(l='  ')\n        cmds.button(label='  Toggle Marker Geo   ', command=(partial(toggleBallPnts)))\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.button(label=' Snap Markers to Geo ', command=(partial(snapMarkers)))\n        cmds.text(l='  ')\n        cmds.button(label='  Delete Marker-pair   ', command=(partial(deletePoints)))\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.button(label='Export Markers', command=(partial(exportPoints)))\n        cmds.text(l='  ')\n        cmds.button(label='Import Markers', command=(partial(importPoints)))\n        cmds.setParent(top=1)\n        cmds.text(l='     Edit TopoMesh : ', h=30, al='left')\n        cmds.rowColumnLayout(nc=3)\n        cmds.text(l='     ')\n        cmds.rowColumnLayout(nc=3)\n        cmds.button(label='   Create Exclude Set   ', command=(partial(createExcludeSet)))\n        cmds.text(l='  ')\n        cmds.button(label='   Toggle Ref Mode   ', command=(partial(toggleRefMode)))\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.button(label='   Paint Relax Topo    ', command=(partial(paintRelax)))\n        cmds.text(l='  ')\n        cmds.button(label='   Paint Retain Shape   ', command=(partial(paintRetainShape)))\n        cmds.setParent(top=1)\n        cmds.text(l='     Bake Textures : ', h=30, al='left')\n        cmds.rowColumnLayout(nc=3)\n        cmds.text(l='     ')\n        cmds.rowColumnLayout(nc=3)\n        cmds.columnLayout()\n        selectedMenuItem = cmds.optionMenu('res', label='Resolution')\n        a = cmds.menuItem(label='1024')\n        b = cmds.menuItem(label='2048')\n        c = cmds.menuItem(label='4096')\n        cmds.setParent('..')\n        cmds.text(l='     ')\n        cmds.button(label='   Bake Texture    ', command=(partial(bakeTex, selectedMenuItem)))\n        cmds.showWindow(windowID)\ntopoWrapUI()" 
        -enableBackground 0
        -backgroundColor 0 0 0 
        -highlightColor 0.321569 0.521569 0.65098 
        -align "center" 
        -label "# uncompyle6 version 3.5.0\n# Python bytecode 3.7 (3394)\n# Decomp..." 
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -imageOverlayLabel "topoWrap" 
        -overlayLabelColor 0.8 0.8 0.8 
        -overlayLabelBackColor 0 0 0 0.5 
        -image "pythonFamily.png" 
        -image1 "pythonFamily.png" 
        -style "iconOnly" 
        -marginWidth 1
        -marginHeight 1
        -command "# uncompyle6 version 3.5.0\n# Python bytecode 3.7 (3394)\n# Decompiled from: Python 2.7.5 (default, Nov 16 2020, 22:23:17) \n# [GCC 4.8.5 20150623 (Red Hat 4.8.5-44)]\n# Embedded file name: C:/Users/Abhishek/Documents/maya/2022/scripts\\topoWrap.py\n# Size of source mod 2**32: 60682 bytes  '314257216956563674'\nimport uuid,platform\n\nPCN=platform.node()\nloc = str(uuid.uuid4())\nloc = loc.split('-')\ncmds.optionVar(sv=['sphereAxisModeTW', loc[0]])\ncmds.optionVar(sv=['cubeAxisModeTW', loc[2]])\ncmds.optionVar(sv=['planeAxisModeTW', loc[3]])\ncmds.optionVar(sv=['coneAxisModeTW', loc[1]])\ncmds.optionVar(sv=['cylinderAxisModeTW', PCN])\ncmds.savePrefs()\ncmds.scriptEditorInfo(clearHistory=1)\n#from maya.cmds import cmds\nimport maya.cmds as cmds\n#from maya.mel import mel\nimport maya.mel as mel\nfrom functools import partial\nimport random as rand\nfrom math import *\nimport time\nimport maya.api.OpenMaya as om\n#from pymel.core import core as pm\nimport pymel.core as pm\nimport pymel.core as core\nimport colorsys, json\n\ndef Func1(mode='cust'):\n    networkNodes = cmds.ls(type='network')\n    if networkNodes:\n        for node in networkNodes:\n            if cmds.attributeQuery('isAtrapStripNode', node=node, exists=True):\n                pass\n            if cmds.getAttr(node + '.isAtrapStripNode'):\n                if mode == 'all':\n                    trapStripNodes.append(node)\n            elif mode == 'tras':\n                if cmds.attributeQuery('connectedtrasNode', node=node, exists=True):\n                    trapStripNodes.append(node)\n                elif not cmds.attributeQuery('connectedtrasNode', node=node, exists=True):\n                    trapStripNodes.append(node)\n\n\ndef Func2():\n    return 10\n\n\ndef tuts(*args):\n    import webbrowser\n    webbrowser.open('https://www.youtube.com/playlist?list=PLjdbFNyrLnM1i2jBLtlSnaqKdHr3jM0gE')\n\n\ndef aboutUs(*args):\n    import webbrowser\n    webbrowser.open('https://www.facebook.com/UnPlugTools')\n\n\ndef otherProducts(*args):\n    import webbrowser\n    webbrowser.open('https://gumroad.com/unplugtools')\n\n\ndef bakeTex(selectedMenuItem, *args):\n    try:\n        res = cmds.optionMenu(selectedMenuItem, query=True, value=True)\n        res = int(res)\n        initialTime = time.time()\n        sel = cmds.ls(sl=1)\n        if len(sel) != 1:\n            cmds.warning('Please select one Valid Retopo-mesh for Texture Baking')\n        if len(sel) == 1:\n            progres = cmds.window(t=' Texture Baking in Progress ')\n            cmds.columnLayout()\n            progressControl = cmds.progressBar(width=380)\n            cmds.showWindow(progres)\n            progressInc = cmds.progressBar(progressControl, edit=True, pr=0)\n            sel = cmds.ls(sl=1)[0]\n            vs = cmds.getAttr(sel + '.visibility')\n            if vs == 0:\n                cmds.setAttr(sel + '.visibility', 1)\n            cmds.select(topoSetup)\n            loadSetup()\n            cmds.select(cl=1)\n            bb = cmds.xform(sel, bb=1, q=1)\n            wd = bb[3] - bb[0]\n            ht = bb[4] - bb[1]\n            ln = bb[5] - bb[2]\n            avg = (ln + wd + ht) / 3\n            val = 0.01\n            dup = cmds.duplicate(sel)[0]\n            cmds.displaySmoothness(divisionsU=0, divisionsV=0, pointsWire=4, pointsShaded=1, polygonObject=1)\n            cmds.polySmooth(dup, mth=0, sdt=0, ovb=1, ofb=3, ofc=0, ost=0, ocr=0, dv=1, bnr=1, c=1,\n              kb=0,\n              ksb=0,\n              khe=0,\n              kt=1,\n              kmb=1,\n              suv=1,\n              peh=0,\n              sl=1,\n              dpe=1,\n              ps=0.1,\n              ro=1,\n              ch=0)\n            progressInc = cmds.progressBar(progressControl, edit=True, pr=10)\n            cmds.select(dup, mb)\n            cmds.CreateShrinkWrap()\n            shp = cmds.listRelatives(s=1)[0]\n            shwrp = cmds.listConnections(shp, type='shrinkWrap')[0]\n            cmds.setAttr(shwrp + '.projection', 4)\n            cmds.select(cl=1)\n            cmds.delete(dup, ch=1)\n            progressInc = cmds.progressBar(progressControl, edit=True, pr=50)\n            tifBakePath = cmds.workspace(q=1, rd=1) + 'sourceimages/'\n            fileN = tifBakePath + sel + '_topoWrapTex'\n            print(fileN)\n            cmds.surfaceSampler(mo='diffuseRGB', fn=fileN, ff='tif', s=mb, t=dup,\n              uv='map1',\n              mw=res,\n              mh=res,\n              ss=0,\n              so=0,\n              msd=(avg * val * 1.1),\n              max=1,\n              sp='tangent',\n              mm=1,\n              sh=1,\n              ft=0,\n              fs=1,\n              os=1,\n              sm=1,\n              ugn=1,\n              imf=0,\n              fu=0,\n              fv=0)\n            finalTime = time.time()\n            TotalTime = finalTime - initialTime\n            TotalTime = round(TotalTime, 2)\n            progressInc = cmds.progressBar(progressControl, edit=True, pr=100)\n            cmds.deleteUI(progres)\n            cmds.warning('Tex Baking done- Time Taken: ' + str(TotalTime) + ' secs --- Texture Path:  ' + tifBakePath + fileN + '.tif')\n            cmds.select(sel)\n            if vs == 0:\n                cmds.setAttr(sel + '.visibility', 0)\n            cmds.delete(dup)\n    except:\n        cmds.warning('No Valid Retopo Setup Loaded')\n\n\ndef toggleBallPnts(*args):\n    try:\n        cmds.select(topoSetup)\n        loadSetup()\n        elems = cmds.listRelatives(c=1)\n        cmds.select(cl=1)\n        pntsA = len(elems) == 6 and cmds.listRelatives(ga, c=1, pa=1)\n        pntsB = cmds.listRelatives(gb, c=1, pa=1)\n        if pntsA == None:\n            if pntsB == None:\n                cmds.warning('No Topo-Points found in the Setup')\n            else:\n                sphA = []\n                sphB = []\n                for e, f in zip(pntsA, pntsB):\n                    posA = cmds.xform(e, t=1, q=1, ws=1)\n                    posB = cmds.xform(f, t=1, q=1, ws=1)\n                    rad = float(cmds.getAttr(elems[4] + '.scl')) / 150\n                    s = cmds.sphere(r=rad)[0]\n                    cmds.setAttr(s + '.overrideEnabled', 1)\n                    cmds.setAttr(s + '.overrideDisplayType', 2)\n                    sphA.append(s)\n                    cmds.xform(s, t=posA, ws=1)\n                    rad = float(cmds.getAttr(elems[5] + '.scl')) / 150\n                    s = cmds.sphere(r=rad)[0]\n                    cmds.setAttr(s + '.overrideEnabled', 1)\n                    cmds.setAttr(s + '.overrideDisplayType', 2)\n                    sphB.append(s)\n                    cmds.xform(s, t=posB, ws=1)\n\n                grpA = cmds.group(sphA, n='markGeoA')\n                cmds.hyperShade(assign=(lam3[0]))\n                cmds.parent(grpA, topoSetup)\n                grpB = cmds.group(sphB, n='markGeoB')\n                cmds.hyperShade(assign=(lam4[0]))\n                cmds.parent(grpB, topoSetup)\n                cmds.select(cl=1)\n                cmds.warning('Geo Markers ON')\n            if len(elems) > 6:\n                cmds.delete(elems[6], elems[7])\n                cmds.warning('Geo Markers OFF')\n    except:\n        cmds.warning('No Valid Retopo Setup Loaded')\n\n\ndef snapMarkers(*args):\n    try:\n        cmds.select(topoSetup)\n        loadSetup()\n        cmds.select(cl=1)\n        cmds.warning('Markers Snapping in Progress')\n        CPOM1 = cmds.createNode('closestPointOnMesh')\n        cmds.connectAttr(ma + '.worldMatrix', CPOM1 + '.inputMatrix')\n        cmds.connectAttr(ma + '.worldMesh', CPOM1 + '.inMesh')\n        CPOM2 = cmds.createNode('closestPointOnMesh')\n        cmds.connectAttr(mb + '.worldMatrix', CPOM2 + '.inputMatrix')\n        cmds.connectAttr(mb + '.worldMesh', CPOM2 + '.inMesh')\n        pntsA = cmds.listRelatives(ga, c=1, pa=1)\n        pntsB = cmds.listRelatives(gb, c=1, pa=1)\n        if pntsA == None:\n            if pntsB == None:\n                cmds.warning('No Topo-Points found in the Setup')\n            else:\n                x = len(pntsB)\n                window = cmds.window(t='Markers Snapping Progress')\n                cmds.columnLayout()\n                progressControl = cmds.progressBar(maxValue=x, width=300)\n                cmds.showWindow(window)\n                p = 0\n                for e, f in zip(pntsA, pntsB):\n                    posA = cmds.xform(e, t=1, q=1, ws=1)\n                    cmds.setAttr(CPOM1 + '.inPositionX', posA[0])\n                    cmds.setAttr(CPOM1 + '.inPositionY', posA[1])\n                    cmds.setAttr(CPOM1 + '.inPositionZ', posA[2])\n                    newPosA = cmds.getAttr(CPOM1 + '.p')[0]\n                    cmds.lockNode(e, lock=0)\n                    unlockT(e)\n                    cmds.xform(e, t=newPosA, ws=1)\n                    lockT(e)\n                    cmds.lockNode(e, lock=1)\n                    posB = cmds.xform(f, t=1, q=1, ws=1)\n                    cmds.setAttr(CPOM2 + '.inPositionX', posB[0])\n                    cmds.setAttr(CPOM2 + '.inPositionY', posB[1])\n                    cmds.setAttr(CPOM2 + '.inPositionZ', posB[2])\n                    newPosB = cmds.getAttr(CPOM2 + '.p')[0]\n                    x1 = str(posB[0])\n                    x1 = float(x1[0:8])\n                    x2 = str(newPosB[0])\n                    x2 = float(x2[0:8])\n                    y1 = str(posB[1])\n                    y1 = float(y1[0:8])\n                    y2 = str(newPosB[1])\n                    y2 = float(y2[0:8])\n                    z1 = str(posB[2])\n                    z1 = float(z1[0:8])\n                    z2 = str(newPosB[2])\n                    z2 = float(z2[0:8])\n                    if x1 != x2:\n                        pass\n                    if y1 != y2:\n                        if z1 != z2:\n                            cmds.lockNode(f, lock=0)\n                            unlockT(f)\n                            cmds.xform(f, t=newPosB, ws=1)\n                            lockT(f)\n                            cmds.lockNode(f, lock=1)\n                        progressInc = cmds.progressBar(progressControl, edit=True, pr=p)\n                        p = p + 1\n\n            cmds.delete(CPOM1, CPOM2)\n            cmds.deleteUI(window)\n            cmds.warning('Markers Snapping Complete')\n    except:\n        cmds.warning('No Valid Retopo Setup Loaded')\n\n\ndef exportPoints(*args):\n    global posAs\n    global posBs\n    try:\n        cmds.select(topoSetup)\n        loadSetup()\n        cmds.select(cl=1)\n        pntsA = cmds.listRelatives(ga, c=1, pa=1)\n        pntsB = cmds.listRelatives(gb, c=1, pa=1)\n        if pntsA == None:\n            if pntsB == None:\n                cmds.warning('No Topo-Points found in the Setup')\n        else:\n            posAs = []\n            posBs = []\n            for e, f in zip(pntsA, pntsB):\n                posA = cmds.xform(e, t=1, q=1, ws=1)\n                posB = cmds.xform(f, t=1, q=1, ws=1)\n                posAs.append(posA)\n                posBs.append(posB)\n\n            PntsPosPair = (\n             posAs, posBs)\n            PntsPosPair = json.dumps(PntsPosPair)\n            savePath = cmds.fileDialog2(fileFilter='*.marks', dialogStyle=2)\n            f = open(savePath[0], 'w+')\n            f.write(PntsPosPair)\n            f.close()\n    except:\n        cmds.warning('No Valid Retopo Setup Loaded')\n\n\ndef importPoints(*args):\n    try:\n        cmds.select(topoSetup)\n        loadSetup()\n        cmds.select(cl=1)\n        pntsA = cmds.listRelatives(ga, c=1, pa=1)\n        pntsB = cmds.listRelatives(gb, c=1, pa=1)\n        if ga == None:\n            if gb == None:\n                cmds.warning('No Topo-Points found in the Setup')\n        elif pntsA != None:\n            cmds.warning('The Setup already got Points')\n        else:\n            if pntsA == None:\n                loadPath = cmds.fileDialog()\n                load = open(loadPath, 'r')\n                PntsPosPair = load.read()\n                PntsPosPair = json.loads(PntsPosPair)\n                c = 1\n                for ps in PntsPosPair:\n                    cnt = 1\n                    for e in ps:\n                        s = cmds.sphere(r=0.01)[0]\n                        cmds.xform(s, t=e, ws=1)\n                        an = cmds.annotate(s, p=(e[0], e[1], e[2]))\n                        cmds.pickWalk(d='up')\n                        an = cmds.ls(sl=1)[0]\n                        cmds.delete(s)\n                        cmds.setAttr(an + '.displayArrow', 0)\n                        cmds.setAttr((an + '.text'), cnt, type='string')\n                        cmds.setAttr(an + '.overrideEnabled', 1)\n                        cmds.setAttr(an + '.overrideRGBColors', 1)\n                        if c == 1:\n                            cmds.setAttr(an + '.overrideColorRGB', 1, 0, 0)\n                        if c == 2:\n                            cmds.setAttr(an + '.overrideColorRGB', 0, 1, 0)\n                        cmds.select(an)\n                        if c == 1:\n                            cmds.rename('markerA_' + str(cnt))\n                        if c == 2:\n                            cmds.rename('markerB_' + str(cnt))\n                        an = cmds.ls(sl=1)[0]\n                        cnt += 1\n                        lockT(an)\n                        ann = pm.ls(sl=1)\n                        if c == 1:\n                            cmds.parent(an, ga)\n                        if c == 2:\n                            cmds.parent(an, gb)\n                        pm.lockNode(ann)\n                        cmds.select(cl=1)\n\n                    c += 1\n\n    except:\n        cmds.warning('No Valid Retopo Setup Loaded')\n\n\ndef hideUnhidePnts(*args):\n    try:\n        cmds.select(topoSetup)\n        loadSetup()\n        cmds.select(cl=1)\n        pntsA = cmds.listRelatives(ga, c=1, pa=1)\n        pntsB = cmds.listRelatives(gb, c=1, pa=1)\n        if pntsA == None:\n            cmds.warning('No Topo-Points found in the Setup')\n        else:\n            hq = cmds.getAttr(pntsA[0] + '.visibility')\n            for e, f in zip(pntsA, pntsB):\n                if hq == True:\n                    cmds.setAttr(e + '.visibility', 0)\n                    cmds.setAttr(f + '.visibility', 0)\n                    cmds.warning('Show - OFF')\n                if hq == False:\n                    cmds.setAttr(e + '.visibility', 1)\n                    cmds.setAttr(f + '.visibility', 1)\n                    cmds.warning('Show - ON')\n\n    except:\n        cmds.warning('No Valid Retopo Setup Loaded')\n\n\ndef deleteSetup(*args):\n    try:\n        cmds.select(topoSetup)\n        loadSetup()\n        pntsA = cmds.listRelatives(ga, c=1, pa=1)\n        pntsB = cmds.listRelatives(gb, c=1, pa=1)\n        try:\n            for e in pntsA:\n                cmds.lockNode(e, lock=0)\n\n            for e in pntsB:\n                cmds.lockNode(e, lock=0)\n\n        except:\n            pass\n\n        cmds.lockNode(ma, lock=0)\n        cmds.lockNode(mb, lock=0)\n        unlockT(ma)\n        unlockT(mb)\n        cmds.select(ga)\n        cmds.pickWalk(d='up')\n        cmds.delete()\n        cmds.warning('Retopo Setup Deleted')\n    except:\n        cmds.warning('No Retopo Setup Found')\n\n\ndef loadSetup(*args):\n    global ga\n    global gb\n    global lam1\n    global lam2\n    global lam3\n    global lam4\n    global ma\n    global mb\n    global topoSetup\n    sell = cmds.ls(sl=1, l=1)\n    topoSetup = cmds.ls(sl=1, l=1)\n    if len(sell) == 0:\n        cmds.warning('Please Select A Retopo Setup to Load')\n    else:\n        try:\n            sel = cmds.listRelatives(sell, c=1, pa=1)\n            ga = sel[0]\n            gas = ga.split('|')\n            if len(gas) > 1:\n                ga = gas[(len(gas) - 1)]\n            if ga != 'markers_A_grp':\n                cmds.warning('Please Select B Valid Retopo Setup to Load')\n            else:\n                gb = sel[1]\n                ma = sel[2]\n                mb = sel[3]\n                shp = cmds.listRelatives(ma, pa=1)[0]\n                lc = cmds.listConnections(shp)\n                lam1 = cmds.listConnections(lc, type='lambert')[0]\n                shp = cmds.listRelatives(mb, pa=1)[0]\n                lc = cmds.listConnections(shp)\n                lam2 = cmds.listConnections(lc, type='lambert')[0]\n                lam3 = cmds.ls('markerAColor')\n                lam4 = cmds.ls('markerBColor')\n                cmds.warning(' Retopo Setup Loadaded')\n        except:\n            cmds.warning('Please Select C Valid Retopo Setup to Load')\n\n\ndef createExcludeSet(*args):\n    global excludeSet\n    sel = cmds.ls(sl=1, fl=1)\n    if len(sel) == 0:\n        cmds.warning('Please Select some Vertices to Exclude from Snap')\n    else:\n        try:\n            vtx = sel[0].split('[')[0]\n            vtxN = vtx.split('.')[1]\n            if vtxN == 'vtx':\n                excludeSet = cmds.sets(n='excludeSet')\n            else:\n                cmds.warning('Please Select some Vertices to Exclude from Snap')\n        except:\n            cmds.warning('Please Select some Vertices to Exclude from Snap')\n\n\ndef toggleRefMode(*args):\n    try:\n        cmds.select(topoSetup)\n        loadSetup()\n        cmds.select(cl=1)\n        ord = cmds.getAttr(ma + '.overrideEnabled')\n        if ord == 1:\n            cmds.setAttr(ma + '.overrideEnabled', 0)\n            cmds.setAttr(mb + '.overrideEnabled', 0)\n            cmds.warning('Set to Normal Select Mode')\n        if ord == 0:\n            cmds.setAttr(ma + '.overrideEnabled', 1)\n            cmds.setAttr(mb + '.overrideEnabled', 1)\n            cmds.warning('Set to Reference Mode')\n    except:\n        cmds.warning('No Retopo Setup Found')\n\n\ndef createSetup(*args):\n    global ga\n    global gb\n    global lam1\n    global lam2\n    global lam3\n    global lam4\n    global ma\n    global mb\n    global topoSetup\n    sell = cmds.ls(sl=1)\n    if len(sell) == 2:\n        sel = cmds.duplicate(sell)\n        cmds.hide(sell)\n        pls = []\n        for e in sel:\n            cmds.setAttr(e + '.overrideEnabled', 1)\n            cmds.setAttr(e + '.overrideDisplayType', 2)\n            bb = cmds.xform(e, bb=1, q=1)\n            cntr = cmds.objectCenter(e, gl=1)\n            ln = bb[4] - bb[1]\n            ht = bb[5] - bb[2]\n            pl = cmds.polyPlane(w=(ln * 1.2), h=(ht * 1.2), n='axisRef_01')[0]\n            cmds.addAttr(pl, ln='scl', dt='string')\n            cmds.setAttr((pl + '.scl'), ht, type='string', l=1)\n            pls.append(pl)\n            shp = cmds.listRelatives(pl, s=1, pa=1)[0]\n            cmds.setAttr(shp + '.template', 1)\n            cmds.rotate(0, 0, 90)\n            cmds.move(cntr[0], cntr[1], cntr[2])\n            cmds.makeIdentity(apply=1, t=1, r=1, s=1, n=0, pn=1)\n            cmds.delete(ch=1)\n\n        topoSetup = cmds.group(em=1, n='Retop_Setup_01')\n        ga = cmds.group(em=1, n='markers_A_grp')\n        gb = cmds.group(em=1, n='markers_B_grp')\n        cmds.parent(ga, gb, topoSetup)\n        cmds.parent(sel, topoSetup)\n        cmds.parent(pls, topoSetup)\n        sel = cmds.listRelatives(topoSetup, c=1, pa=1)\n        ga = sel[0]\n        gb = sel[1]\n        ma = sel[2]\n        mb = sel[3]\n        lockT(sel[2])\n        lockT(sel[3])\n        cmds.lockNode(ma)\n        cmds.lockNode(mb)\n        lam1 = cmds.shadingNode('lambert', asShader=1, n='BaseTopoColor')\n        lam2 = cmds.shadingNode('lambert', asShader=1, n='RawModelColor')\n        lam3 = cmds.shadingNode('lambert', asShader=1, n='markerAColor')\n        lam4 = cmds.shadingNode('lambert', asShader=1, n='markerBColor')\n        cmds.setAttr((lam3 + '.color'), 1, 0, 0, type='double3')\n        cmds.setAttr((lam4 + '.color'), 0, 1, 0, type='double3')\n        cmds.select(ma)\n        cmds.hyperShade(assign=lam1)\n        cmds.select(mb)\n        cmds.hyperShade(assign=lam2)\n        cmds.select(cl=1)\n    else:\n        cmds.warning('Please Select 2 meshes: a Source and a Target Mesh')\n\n\ndef tweakPointsA(*args):\n    try:\n        lamCol1 = cmds.getAttr(lam1 + '.color')\n        lamCol2 = cmds.getAttr(lam2 + '.color')\n        if lamCol1[0][0] == 0.5:\n            exitTweakPoints()\n            sel = cmds.ls(sl=1)\n            pntsA = cmds.listRelatives(ga, c=1, pa=1)\n            for e in pntsA:\n                cmds.lockNode(e, lock=0)\n                unlockT(e)\n                cmds.lockNode(e, lock=1)\n\n            cmds.setAttr((lam1 + '.color'), 0.2, 0.3, 0.5, type='double3')\n            cmds.setAttr((lam2 + '.color'), 0.5, 0.5, 0.5, type='double3')\n            cmds.setToolTo('Move')\n            cmds.select(ma)\n            cmds.makeLive()\n            cmds.select(sel)\n        else:\n            exitTweakPoints()\n    except:\n        cmds.warning('No Valid Retopo Setup Found')\n\n\ndef tweakPointsB(*args):\n    try:\n        lamCol1 = cmds.getAttr(lam1 + '.color')\n        lamCol2 = cmds.getAttr(lam2 + '.color')\n        if lamCol2[0][0] == 0.5:\n            exitTweakPoints()\n            sel = cmds.ls(sl=1)\n            pntsB = cmds.listRelatives(gb, c=1, pa=1)\n            for e in pntsB:\n                cmds.lockNode(e, lock=0)\n                unlockT(e)\n                cmds.lockNode(e, lock=1)\n\n            cmds.setAttr((lam2 + '.color'), 0.2, 0.3, 0.5, type='double3')\n            cmds.setAttr((lam1 + '.color'), 0.5, 0.5, 0.5, type='double3')\n            cmds.setToolTo('Move')\n            cmds.select(mb)\n            cmds.makeLive()\n            cmds.select(sel)\n        else:\n            exitTweakPoints()\n    except:\n        cmds.warning('No Valid Retopo Setup Found')\n\n\ndef paintRelax(*args):\n    sel = cmds.ls(sl=1)\n    if len(sel) == 0:\n        cmds.warning('Please Select a Mesh to Relax')\n    else:\n        cmds.SculptGeometryTool()\n        try:\n            cmds.artPuttyCtx('artPuttyContext')\n        except:\n            pass\n\n        cmds.setToolTo('artPuttyContext')\n        cmds.toolPropertyWindow()\n        mel.eval('artPuttyCtx -e -opacity 0.002 `currentCtx`')\n        mel.eval('artPuttyCtx -e -reflection  true `currentCtx`')\n        cmds.stackTrace(state=0)\n        mel.eval('artUpdatePuttyOperation artPuttyCtx relax ')\n        cmds.stackTrace(state=1)\n        cmds.scriptEditorInfo(clearHistory=True)\n\n\ndef exitTweakPoints(*args):\n    sel = cmds.ls(sl=1)\n    pntsA = cmds.listRelatives(ga, c=1, pa=1)\n    pntsB = cmds.listRelatives(gb, c=1, pa=1)\n    try:\n        for e in pntsA:\n            cmds.lockNode(e, lock=0)\n            lockT(e)\n            cmds.lockNode(e, lock=1)\n\n    except:\n        pass\n\n    try:\n        for e in pntsB:\n            cmds.lockNode(e, lock=0)\n            lockT(e)\n            cmds.lockNode(e, lock=1)\n\n    except:\n        pass\n\n    cmds.setAttr((lam1 + '.color'), 0.5, 0.5, 0.5, type='double3')\n    cmds.setAttr((lam2 + '.color'), 0.5, 0.5, 0.5, type='double3')\n    cmds.select(cl=1)\n    cmds.makeLive()\n    cmds.select(sel)\n\n\ndef deletePoints(*args):\n    sel = cmds.ls(sl=1)\n    if len(sel) == 0:\n        cmds.warning('Please Select Marker-Points to delete')\n    else:\n        try:\n            pntsA = cmds.listRelatives(ga, c=1, pa=1)\n            sell = []\n            for e in sel:\n                lr = cmds.listRelatives(e, c=1, pa=1)\n                typ = cmds.objectType(lr)\n                if typ == 'annotationShape':\n                    sell.append(e)\n                pntsA = cmds.listRelatives(ga, c=1, pa=1)\n                pntsB = cmds.listRelatives(gb, c=1, pa=1)\n                for sl in sell:\n                    for e, f in zip(pntsA, pntsB):\n                        if sl == e or sl == f:\n                            cmds.lockNode(e, lock=0)\n                            cmds.lockNode(f, lock=0)\n                            cmds.delete(e, f)\n\n                    try:\n                        cmds.delete(sl)\n                    except:\n                        pass\n\n                pntsA = cmds.listRelatives(ga, c=1, pa=1)\n                pntsB = cmds.listRelatives(gb, c=1, pa=1)\n                ct = 1\n                try:\n                    for e, f in zip(pntsA, pntsB):\n                        cmds.setAttr((e + '.text'), ct, type='string')\n                        cmds.setAttr((f + '.text'), ct, type='string')\n                        ct += 1\n\n                except:\n                    pass\n\n                cmds.select(cl=1)\n\n        except:\n            cmds.warning('No Valid Retopo Setup found')\n\n\ndef mirrorPoints(*args):\n    try:\n        sel = cmds.ls(sl=1)\n        cmds.select(topoSetup)\n        loadSetup()\n        cmds.warning('Done')\n        cmds.select(sel)\n        if len(sel) > 0:\n            pntsA = cmds.listRelatives(ga, c=1, pa=1)\n            pntsB = cmds.listRelatives(gb, c=1, pa=1)\n            lenPnt = len(pntsB)\n            try:\n                cmds.lockNode((pntsA[lenPnt]), lock=0)\n                cmds.delete(pntsA[lenPnt])\n                pntsA = cmds.listRelatives(ga, c=1, pa=1)\n                pntsB = cmds.listRelatives(gb, c=1, pa=1)\n            except:\n                pass\n\n            dupPntsA = []\n            dupPntsB = []\n            for sl in sel:\n                for e, f in zip(pntsA, pntsB):\n                    if sl == e or sl == f:\n                        d = cmds.duplicate(e)[0]\n                        dupPntsA.append(d)\n                        d = cmds.duplicate(f)[0]\n                        dupPntsB.append(d)\n\n        else:\n            pntsA = cmds.listRelatives(ga, c=1, pa=1)\n            pntsB = cmds.listRelatives(gb, c=1, pa=1)\n            if pntsB == None:\n                cmds.warning('No Topo-Points found for Mirroring')\n            else:\n                lenPnt = len(pntsB)\n                try:\n                    cmds.lockNode((pntsA[lenPnt]), lock=0)\n                    cmds.delete(pntsA[lenPnt])\n                    pntsA = cmds.listRelatives(ga, c=1, pa=1)\n                    pntsB = cmds.listRelatives(gb, c=1, pa=1)\n                except:\n                    pass\n\n                pntsAB = (\n                 pntsA, pntsB)\n                for ee in pntsAB:\n                    pv = [\n                     'a']\n                    ng = ['a']\n                    for e in ee:\n                        p = cmds.xform(e, t=1, ws=1, q=1)[0]\n                        pe = [p, e]\n                        if p < 0:\n                            ng.append(pe)\n                        else:\n                            pv.append(pe)\n\n                    xxx = [\n                     [\n                      len(pv), pv], [len(ng), ng]]\n                    xxx.sort()\n                    for e in xxx[0][1]:\n                        try:\n                            cmds.lockNode((e[1]), lock=0)\n                            cmds.delete(e[1])\n                        except:\n                            pass\n\n                pntsA = cmds.listRelatives(ga, c=1, pa=1)\n                pntsB = cmds.listRelatives(gb, c=1, pa=1)\n                dupPntsA = cmds.duplicate(pntsA)\n                dupPntsB = cmds.duplicate(pntsB)\n        if pntsA == None:\n            cmds.warning('No Topo-Points found for Mirroring')\n        else:\n            for e, f in zip(dupPntsA, dupPntsB):\n                unlockT(e)\n                unlockT(f)\n                vl = cmds.getAttr(e + '.translateX')\n                cmds.setAttr(e + '.translateX', -vl)\n                vl = cmds.getAttr(f + '.translateX')\n                cmds.setAttr(f + '.translateX', -vl)\n                lockT(e)\n                lockT(f)\n                cmds.lockNode(e)\n                cmds.lockNode(f)\n\n            pntsA = cmds.listRelatives(ga, c=1)\n            pntsB = cmds.listRelatives(gb, c=1)\n            ct = 1\n            for e, f in zip(pntsA, pntsB):\n                cmds.setAttr((e + '.text'), ct, type='string')\n                cmds.setAttr((f + '.text'), ct, type='string')\n                ct += 1\n\n    except:\n        cmds.warning('No Valid Retopo Setup or Points Found')\n\n\ndef drawPoints(*args):\n    try:\n        cmds.select(topoSetup)\n        loadSetup()\n        cmds.warning('Tip: Draw your Topo-Points Alternately on your Source & Target meshes')\n        cmds.jointDisplayScale(0.2)\n        pntsA = cmds.listRelatives(ga, c=1, pa=1)\n        pntsB = cmds.listRelatives(gb, c=1, pa=1)\n        if pntsA == None:\n            pntsA = 0\n        else:\n            pntsA = len(pntsA)\n        if pntsB == None:\n            pntsB = 0\n        else:\n            pntsB = len(pntsB)\n        if pntsA > pntsB:\n            live = mb\n        if pntsA == pntsB:\n            live = ma\n        cmds.select(live)\n        shp = cmds.listRelatives(live)[0]\n        lc = cmds.listConnections(shp)\n        lam = cmds.listConnections(lc, type='lambert')[0]\n        cmds.setAttr((lam + '.color'), 0.2, 0.4, 0.4, type='double3')\n        cmds.makeLive()\n        cmds.JointTool()\n        cmds.scriptJob(event=['DagObjectCreated', 'setPntsJb()'], compressUndo=True)\n        cmds.scriptJob(event=['ToolChanged', 'kldrwJb()'], runOnce=True)\n    except:\n        cmds.warning('No Valid Retopo Setup Found')\n\n\ndef lockT(an):\n    cmds.setAttr((an + '.tx'), lock=1)\n    cmds.setAttr((an + '.ty'), lock=1)\n    cmds.setAttr((an + '.tz'), lock=1)\n    cmds.setAttr((an + '.rx'), lock=1)\n    cmds.setAttr((an + '.ry'), lock=1)\n    cmds.setAttr((an + '.rz'), lock=1)\n    cmds.setAttr((an + '.sx'), lock=1)\n    cmds.setAttr((an + '.sy'), lock=1)\n    cmds.setAttr((an + '.sz'), lock=1)\n\n\ndef unlockT(an):\n    cmds.setAttr((an + '.tx'), lock=0)\n    cmds.setAttr((an + '.ty'), lock=0)\n    cmds.setAttr((an + '.tz'), lock=0)\n    cmds.setAttr((an + '.rx'), lock=0)\n    cmds.setAttr((an + '.ry'), lock=0)\n    cmds.setAttr((an + '.rz'), lock=0)\n    cmds.setAttr((an + '.sx'), lock=0)\n    cmds.setAttr((an + '.sy'), lock=0)\n    cmds.setAttr((an + '.sz'), lock=0)\n\n\ndef setPntsJb(*args):\n    global an2\n    pntsA = cmds.listRelatives(ga, c=1)\n    pntsB = cmds.listRelatives(gb, c=1)\n    if pntsA == None:\n        pntsA = 0\n    else:\n        pntsA = len(pntsA)\n    if pntsB == None:\n        pntsB = 0\n    else:\n        pntsB = len(pntsB)\n    if pntsA > pntsB:\n        cnt = 0\n    if pntsA == pntsB:\n        cnt = 1\n    jt = cmds.ls(sl=1)[0]\n    cmds.setAttr(jt + '.radius', 0.01)\n    p = cmds.xform(jt, t=1, ws=1, q=1)\n    s = cmds.sphere(r=0.01)[0]\n    cmds.xform(s, t=p, ws=1)\n    an = cmds.annotate(s, p=(p[0], p[1], p[2]))\n    cmds.pickWalk(d='up')\n    an = cmds.ls(sl=1)[0]\n    cmds.delete(jt, s)\n    if cnt % 2 != 0:\n        cmds.setAttr((lam2 + '.color'), 0.2, 0.4, 0.4, type='double3')\n        cmds.setAttr((lam1 + '.color'), 0.5, 0.5, 0.5, type='double3')\n        cmds.setAttr(an + '.displayArrow', 0)\n        cmds.setAttr((an + '.text'), (pntsA + 1), type='string')\n        cmds.setAttr(an + '.overrideEnabled', 1)\n        cmds.setAttr(an + '.overrideRGBColors', 1)\n        cmds.setAttr(an + '.overrideColorRGB', 1, 1, 0)\n        cmds.select(an)\n        cmds.rename('markerA_' + str(pntsA + 1))\n        an = cmds.ls(sl=1)[0]\n        lockT(an)\n        ann = pm.ls(sl=1)\n        an2 = pm.ls(sl=1)[0]\n        cmds.parent(an, ga)\n        pm.lockNode(ann)\n        cmds.select(cl=1)\n        cmds.makeLive()\n        live = mb\n        cmds.select(live)\n        cmds.makeLive()\n        live = mb\n    if cnt % 2 == 0:\n        cmds.setAttr((lam2 + '.color'), 0.5, 0.5, 0.5, type='double3')\n        cmds.setAttr((lam1 + '.color'), 0.2, 0.4, 0.4, type='double3')\n        cmds.setAttr(an + '.displayArrow', 0)\n        cmds.setAttr((an + '.text'), (pntsB + 1), type='string')\n        cmds.setAttr(an + '.overrideEnabled', 1)\n        cmds.setAttr(an + '.overrideRGBColors', 1)\n        cmds.setAttr(an + '.overrideColorRGB', 0, 1, 0)\n        try:\n            pm.setAttr(an2 + '.overrideColorRGB', 1, 0, 0)\n        except:\n            pass\n\n        cmds.select(an)\n        cmds.rename('markerB_' + str(pntsB + 1))\n        an = cmds.ls(sl=1)[0]\n        lockT(an)\n        ann = pm.ls(sl=1)\n        cmds.parent(an, gb)\n        pm.lockNode(ann)\n        cmds.select(cl=1)\n        cmds.makeLive()\n        live = ma\n        cmds.select(live)\n        cmds.makeLive()\n        live = ma\n    cmds.scriptEditorInfo(clearHistory=1)\n\n\ndef kldrwJb(*args):\n    all = cmds.scriptJob(lj=True)\n    for a in all:\n        if 'setPntsJb' in a:\n            b = int(a.split(':')[0])\n            cmds.scriptJob(kill=(int(a.split(':')[0])))\n            cmds.setAttr((lam1 + '.color'), 0.5, 0.5, 0.5, type='double3')\n            cmds.setAttr((lam2 + '.color'), 0.5, 0.5, 0.5, type='double3')\n            cmds.jointDisplayScale(1)\n            cmds.makeLive()\n\n\ndef snapRetopo(*args):\n    try:\n        cmds.select(topoSetup)\n        loadSetup()\n        cmds.warning('Retopo Mesh Creation in Progress')\n        cmds.select(cl=1)\n        try:\n            pntsA = cmds.listRelatives(ga, c=1, pa=1)\n            pntsB = cmds.listRelatives(gb, c=1, pa=1)\n        except:\n            cmds.warning('Please Create Marker Points')\n\n        if pntsB == None:\n            cmds.warning('Please Create Marker Points')\n        else:\n            lenPnt = len(pntsB)\n            if lenPnt < 4:\n                cmds.warning('Cannot create Retopo Mesh, Please create minimum 4 Marker Points or more')\n            else:\n                progres = cmds.window(t=' Creating Retopo Mesh ')\n                cmds.columnLayout()\n                progressControl = cmds.progressBar(width=380)\n                cmds.showWindow(progres)\n                progressInc = cmds.progressBar(progressControl, edit=True, pr=0)\n                try:\n                    cmds.lockNode((pntsA[lenPnt]), lock=0)\n                    cmds.delete(pntsA[lenPnt])\n                    pntsA = cmds.listRelatives(ga, c=1, pa=1)\n                    pntsB = cmds.listRelatives(gb, c=1, pa=1)\n                except:\n                    pass\n\n                jtsA = []\n                pls = []\n                for e in pntsA:\n                    p = cmds.xform(e, t=1, ws=1, q=1)\n                    cmds.select(cl=1)\n                    jt = cmds.joint(radius=0.01, p=(p[0], p[1], p[2]))\n                    cmds.select(cl=1)\n                    pl = cmds.polyPlane(sx=1, sy=1, w=0.001, h=0.001)[0]\n                    cmds.xform(pl, t=p, ws=1)\n                    pls.append(pl)\n                    jtsA.append(jt)\n\n                progressInc = cmds.progressBar(progressControl, edit=True, pr=10)\n                plsGrp = cmds.group(pls)\n                ptc = cmds.polyUnite(ch=0, n='ptc')[0]\n                lowMesh = cmds.duplicate(ma, n='lowMesh')[0]\n                retopMesh = cmds.duplicate(ma, n='retopMesh_01')[0]\n                cmds.polySmooth(lowMesh, ch=0, dv=1)\n                progressInc = cmds.progressBar(progressControl, edit=True, pr=20)\n                cmds.transferAttributes(ptc, lowMesh, transferPositions=1, transferNormals=0, transferUVs=0, transferColors=0, sampleSpace=0,\n                  sourceUvSpace='map1',\n                  targetUvSpace='map1',\n                  searchMethod=3,\n                  flipUVs=0,\n                  colorBorders=1)\n                progressInc = cmds.progressBar(progressControl, edit=True, pr=40)\n                cmds.polyMergeVertex(lowMesh, d=0.005)\n                progressInc = cmds.progressBar(progressControl, edit=True, pr=60)\n                cmds.delete(lowMesh, ch=1)\n                cmds.delete(ptc)\n                cmds.skinCluster(jtsA, lowMesh)\n                cmds.skinCluster(jtsA, retopMesh)\n                cmds.copySkinWeights(lowMesh, retopMesh, noMirror=1, surfaceAssociation='closestPoint', influenceAssociation='closestJoint')\n                for e, f in zip(jtsA, pntsB):\n                    p = cmds.xform(f, t=1, ws=1, q=1)\n                    cmds.xform(e, t=p, ws=1)\n\n                cmds.select(retopMesh)\n                cmds.CenterPivot()\n                cmds.DeleteHistory()\n                cmds.makeIdentity(apply=1, t=1, r=1, s=1, n=0, pn=1)\n                progressInc = cmds.progressBar(progressControl, edit=True, pr=80)\n                baseWrapMesh = cmds.duplicate(retopMesh, n='baseWrap')\n                cmds.transferAttributes(mb, retopMesh, transferPositions=1, transferNormals=0, transferUVs=0, transferColors=0, sampleSpace=0,\n                  sourceUvSpace='map1',\n                  targetUvSpace='map1',\n                  searchMethod=3,\n                  flipUVs=0,\n                  colorBorders=1)\n                cmds.delete(retopMesh, ch=1)\n                cmds.polyNormalPerVertex(retopMesh, ufn=1)\n                cmds.polySoftEdge(retopMesh, a=180, ch=0)\n                cmds.delete(retopMesh, ch=1)\n                bs = cmds.blendShape(baseWrapMesh, retopMesh, n='shapeBlend', w=[(0, 1)])[0]\n                vcnt = cmds.polyEvaluate(retopMesh, v=1)\n                for e in range(vcnt):\n                    cmds.setAttr(bs + '.inputTarget[' + str(0) + '].inputTargetGroup[0].targetWeights' + '[' + str(e) + ']', 0.0)\n\n                try:\n                    cmds.select('excludeSet')\n                    vcnt = cmds.ls(sl=1, fl=1)\n                    vtxs = []\n                    for e in vcnt:\n                        vtx = e.split('[')[0]\n                        vtxN = vtx.split('.')[0]\n                        if vtxN == ma:\n                            vtxs.append(e)\n\n                    for e in vtxs:\n                        vtxNo = e.split('[')[1]\n                        vtxNo = int(vtxNo.split(']')[0])\n                        cmds.setAttr(bs + '.inputTarget[' + str(0) + '].inputTargetGroup[0].targetWeights' + '[' + str(vtxNo) + ']', 1)\n\n                except:\n                    pass\n\n                cmds.delete(baseWrapMesh)\n                cmds.setAttr(retopMesh + '.overrideEnabled', 0)\n                cmds.select(retopMesh)\n                cmds.hyperShade(assign='lambert1')\n                cmds.parent(w=1)\n                cmds.delete(jtsA, lowMesh)\n                progressInc = cmds.progressBar(progressControl, edit=True, pr=100)\n                cmds.deleteUI(progres)\n    except:\n        cmds.warning('No Valid Retopo Setup Found')\n\n\ndef killruntimeJbs():\n    all = cmds.scriptJob(lj=True)\n    for a in all:\n        if 'kldrwJb' in a:\n            b = int(a.split(':')[0])\n            cmds.scriptJob(kill=(int(a.split(':')[0])))\n\n\ndef paintRetainShape(*args):\n    sel = cmds.ls(sl=1)\n    if len(sel) == 0:\n        cmds.warning('Please Select a Rotopo Mesh to Retain')\n    else:\n        cmds.SculptGeometryTool()\n        try:\n            cmds.artAttrCtx('artAttrBlendShapeContext')\n        except:\n            pass\n\n        cmds.setToolTo('artAttrBlendShapeContext')\n\n\ndef enterLicense(*args):\n\n    def feedLCK():\n        result = cmds.promptDialog(title='Enter your License Key for TopoWrap',\n          message='___________Enter your TopoWrap License Key___________',\n          button=[\n         'OK', 'Cancel'],\n          defaultButton='OK',\n          cancelButton='Cancel',\n          dismissString='Cancel')\n        if result == 'OK':\n            enc = cmds.promptDialog(query=True, text=True)\n            enc = str(enc)\n        try:\n\n            def getCPK():\n                return '314257216956563674'\n\n            import base64\n            key = getCPK().encode('ascii')\n            encB64 = enc.encode('ascii')\n            enc2 = base64.urlsafe_b64decode(encB64)\n            dec = []\n            for i in range(len(enc2)):\n                key_c = key[(i % len(key))]\n                dec_c = (256 + enc2[i] - key_c) % 256\n                dec.append(dec_c)\n\n            message = bytes(dec)\n            message = message.decode('ascii')\n            Lic = ''.join(message)\n            Lic = Lic.split('_')\n            chk1 = cmds.optionVar(q='sphereAxisModeTW')\n            chk2 = cmds.optionVar(q='cubeAxisModeTW')\n            if chk1 == Lic[0]:\n                if chk2 == Lic[1]:\n                    cmds.optionVar(sv=['sphereAxisModeTWR', Lic[0]])\n                    cmds.optionVar(sv=['cubeAxisModeTWR', Lic[2]])\n                    cmds.optionVar(sv=['planeAxisModeTWR', Lic[3]])\n                    cmds.optionVar(sv=['coneAxisModeTWR', Lic[1]])\n                    cmds.savePrefs()\n                    cmds.scriptEditorInfo(clearHistory=1)\n                    cmds.warning('CONGRATS..!! Your TopoWrap License is Activated.. Kindly relaunch the Tool UI')\n            else:\n                cmds.warning('License error: Please Enter Correct License Key')\n        except:\n            cmds.warning('License error: Please Enter Correct License Key')\n\n    exs = cmds.optionVar(ex='sphereAxisModeTWR')\n    if exs == 1:\n        cmds.warning('Your Copy is already Licensed')\n    if exs == 0:\n        import platform\n        OS = platform.system()\n        if OS != 'Windows':\n            feedLCK()\n    if OS == 'Windows':\n        feedLCK()\n\n\ndef getActKey(*args):\n\n    def genActKY():\n        import uuid, platform, base64\n        PCN = platform.node()\n        OSnVer = platform.platform()\n        MayaVer = cmds.about(version=1)\n        ex1 = cmds.optionVar(ex='sphereAxisModeTW')\n        ex2 = cmds.optionVar(ex='cubeAxisModeTW')\n        ex3 = cmds.optionVar(ex='planeAxisModeTW')\n        ex4 = cmds.optionVar(ex='coneAxisModeTW')\n\n        def createKeyWin():\n            msgA = cmds.optionVar(q='sphereAxisModeTW')\n            msgB = cmds.optionVar(q='cubeAxisModeTW')\n            msgC = cmds.optionVar(q='planeAxisModeTW')\n            msgD = cmds.optionVar(q='coneAxisModeTW')\n            message = msgA + '_' + msgB + '_' + msgC + '_' + msgD + '_' + PCN + '_' + OSnVer + '_' + 'Maya' + MayaVer\n\n            def getCPK():\n                return '252403183365734451157'\n\n            enc = []\n            clear = message.encode('ascii')\n            key = getCPK().encode('ascii')\n            for i in range(len(clear)):\n                key_c = key[(i % len(key))]\n                enc_c = (clear[i] + key_c) % 256\n                enc.append(enc_c)\n\n            encB64 = base64.urlsafe_b64encode(bytes(enc))\n            enc = encB64.decode('ascii')\n            cmds.warning('Please Copy your TopoWrap ACTIVATION KEY.. and email it to- unplug.tools@gmail.com')\n            if cmds.window('ETWin', exists=True):\n                cmds.deleteUI('ETWin')\n            cmds.window('ETWin', title='Activation Key for TopoWrap', h=60, w=600)\n            cmds.columnLayout(adj=True)\n            cmds.text(label='Please Copy your TopoWrap ACTIVATION KEY.. and email it to- unplug.tools@gmail.com')\n            cmds.text(label='  ctrl+A then ctrl+C')\n            cmds.text(label='')\n            cmds.textField('licGBTextField', text=enc, ed=False, annotation='(Ctrl+A) (Ctrl+C)')\n            cmds.text(label='')\n            cmds.showWindow('ETWin')\n            cmds.setFocus('licGBTextField')\n            cmds.warning('Your Activation Key is')\n            cmds.warning(enc)\n\n        if ex1 != 1:\n            if ex2 != 1:\n                pass\n        if ex3 != 1:\n            if ex4 != 1:\n                loc = str(uuid.uuid4())\n                loc = loc.split('-')\n                cmds.optionVar(sv=['sphereAxisModeTW', loc[0]])\n                cmds.optionVar(sv=['cubeAxisModeTW', loc[2]])\n                cmds.optionVar(sv=['planeAxisModeTW', loc[3]])\n                cmds.optionVar(sv=['coneAxisModeTW', loc[1]])\n                cmds.optionVar(sv=['cylinderAxisModeTW', PCN])\n                cmds.savePrefs()\n                cmds.scriptEditorInfo(clearHistory=1)\n                createKeyWin()\n            if ex1 == 1:\n                if ex2 == 1:\n                    if ex3 == 1:\n                        pass\n        if ex4 == 1:\n            createKeyWin()\n\n    exs = cmds.optionVar(ex='sphereAxisModeTWR')\n    if exs == 1:\n        cmds.warning('Your TopoWrap Copy is already Licensed')\n    if exs == 0:\n        import platform\n        OS = platform.system()\n        if OS != 'Windows':\n            genActKY()\n    if OS == 'Windows':\n        genActKY()\n\n\ndef removeLicense(*args):\n\n    def remLc():\n        remConfirm = cmds.confirmDialog(title='Confirm', message='Are you sure you want to remove TopoWrap License?', button=['Yes', 'No'], defaultButton='Yes', cancelButton='No', dismissString='No')\n        if remConfirm == 'No':\n            cmds.warning('Relax..Your TopoWrap License has NOT been removed')\n        if remConfirm == 'Yes':\n            reremConfirm = cmds.confirmDialog(title='Confirm', message='Please Re-comfrim..!! Are you sure you want to remove TopoWrap License?', button=['Yes', 'No'], defaultButton='Yes', cancelButton='No', dismissString='No')\n            if reremConfirm == 'No':\n                cmds.warning('Relax..Your TopoWrap License has NOT been removed')\n            if reremConfirm == 'Yes':\n                reeremConfirm = cmds.confirmDialog(title='Confirm', message='FINAL RECONFIRM..!! Your FINALLY SURE you want to REMOVE TopoWrap License?', button=['Yes', 'No'], defaultButton='Yes', cancelButton='No', dismissString='No')\n                if reeremConfirm == 'No':\n                    cmds.warning('Relax..Your TopoWrap License has NOT been removed')\n        if reeremConfirm == 'Yes':\n            cmds.optionVar(sv=['gooh3', 1])\n            cmds.optionVar(remove='sphereAxisModeTW')\n            cmds.optionVar(remove='cubeAxisModeTW')\n            cmds.optionVar(remove='planeAxisModeTW')\n            cmds.optionVar(remove='coneAxisModeTW')\n            cmds.optionVar(remove='sphereAxisModeTWR')\n            cmds.optionVar(remove='cubeAxisModeTWR')\n            cmds.optionVar(remove='planeAxisModeTWR')\n            cmds.optionVar(remove='coneAxisModeTWR')\n            cmds.optionVar(remove='cylinderAxisModeTW')\n            cmds.warning('Your `TopoWrap` License has been successfully REMOVED')\n            cmds.evalDeferred('cmds.quit(f=1)')\n\n    chk1 = cmds.optionVar(ex='sphereAxisModeTWR')\n    if chk1 == 0:\n        cmds.warning('NO LICENSE FOUND..!! Your TopoWrap Product is not Registered yet..!!')\n    if chk1 == 1:\n        import platform\n        OS = platform.system()\n        remLc()\n\n\ndef topoWrapUI():\n    for _editor in cmds.lsUI(editors=True):\n        if not cmds.outlinerEditor(_editor, query=True, exists=True):\n            continue\n        _sel_cmd = cmds.outlinerEditor(_editor, query=True, selectCommand=True)\n        if _sel_cmd:\n            if not _sel_cmd.startswith('<function selCom at '):\n                pass\n            else:\n                cmds.outlinerEditor(_editor, edit=True, selectCommand='print(\"\")')\n\n    windowID = 'TopoWrap'\n    if cmds.window(windowID, exists=True):\n        cmds.deleteUI(windowID)\n    import uuid\n    loc = str(uuid.uuid4())        \n    cmds.window(windowID, title='TopoWrap  V1.0 ', menuBar=1, sizeable=1, resizeToFitChildren=1, w=340, h=800)\n    cmds.menu(label=' HELP..!!', tearOff=1)\n    cmds.menuItem(label='Get your Activation Key', c=(partial(getActKey)))\n    cmds.menuItem(label='Enter your License Key', c=(partial(enterLicense)))\n    cmds.menuItem(label='Videos', c=(partial(tuts)))\n    cmds.menuItem(label='About Us', c=(partial(aboutUs)))\n    cmds.menuItem(label='More Products', c=(partial(otherProducts)))\n    cmds.menuItem(label='[Remove License]', c=(partial(removeLicense)), bld=1)\n    cmds.columnLayout(adjustableColumn=1)\n    cmds.text(label='    TOPO-WRAP - Powered by - UNPLUG TOOLS    ', bgc=(0.35, 0.4,\n                                                                          0.45), h=25)\n    cmds.text(label='     unplug.tools@gmail.com     ', bgc=(0.35, 0.4, 0.45), h=20)\n    cmds.text(label='    ', bgc=(0.35, 0.4, 0.4), h=5)\n    cmds.setParent('..')\n\n    def verifyLic():\n        msgA = cmds.optionVar(q='sphereAxisModeTWR')\n        msgB = cmds.optionVar(q='cubeAxisModeTWR')\n        msgC = cmds.optionVar(q='planeAxisModeTWR')\n        msgD = cmds.optionVar(q='coneAxisModeTWR')\n        import platform\n        PCN = platform.node()\n        try:\n            userL = str(msgA) + '_' + str(msgB) + '_' + str(msgC) + '_' + str(msgD) + '_' + PCN\n        except:\n            cmds.warning('License error Please contact your vendor')\n\n        try:\n            msgA = cmds.optionVar(q='sphereAxisModeTW')\n            msgB = cmds.optionVar(q='cubeAxisModeTW')\n            msgC = cmds.optionVar(q='planeAxisModeTW')\n            msgD = cmds.optionVar(q='coneAxisModeTW')\n            msgE = cmds.optionVar(q='cylinderAxisModeTW')\n            key = str(msgA) + '_' + str(msgC) + '_' + str(msgD) + '_' + str(msgB) + '_' + str(msgE)\n        except:\n            cmds.warning('License error: Please contact your vendor')\n\n        return (\n         key, userL)\n    \"\"\"\n    if verifyLic()[0] != verifyLic()[1]:\n        cmds.window(windowID, e=1, h=340, w=250)\n        cmds.columnLayout(adjustableColumn=1)\n        cmds.text(label='No License Installed in this PC', h=20)\n        cmds.text(label='Click below on <Get your Activation Key>', h=20)\n        cmds.button(label='Get your Activation Key', command=(partial(getActKey)))\n        cmds.text(label='Copy your Unique Activation Key', h=20)\n        cmds.text(label='and mail it to - unplug.tools@gmail.com ', h=20)\n        cmds.text(label='along with your Purchase Receipt ', h=20)\n        cmds.text(label='OR your Purchase email ID ', h=20)\n        cmds.separator(h=10)\n        cmds.text(label='Once you recieve your License Key', h=20)\n        cmds.text(label=' Enter the Key by clicking below ', h=20)\n        cmds.button(label='Enter your License Key', c=(partial(enterLicense)))\n        cmds.separator(h=30)\n        cmds.setParent('..')\n        cmds.showWindow(windowID)\n    \"\"\"        \n    #x = verifyLic()[0] == verifyLic()[1] and 1\n    x = 1\n    if x == 1:\n        cmds.window(windowID, e=1, h=550, w=280)\n        cmds.scrollLayout('scrollLayout')\n        cmds.columnLayout()\n        cmds.frameLayout(label='  TopoWrap ToolSets ', collapsable=0, collapse=0, w=270, bgc=(0.3,\n                                                                                              0.4,\n                                                                                              0.45))\n        cmds.text(l='     Retopo Setup Tools : ', h=30, al='left')\n        cmds.rowColumnLayout(nc=3)\n        cmds.text(l='     ')\n        cmds.rowColumnLayout(nc=3)\n        cmds.button(label='        Create Setup       ', command=(partial(createSetup)))\n        cmds.text(l='  ')\n        cmds.button(label='       Create Retopo      ', command=(partial(snapRetopo)))\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.button(label='Load Setup', command=(partial(loadSetup)))\n        cmds.text(l='  ')\n        cmds.button(label='Delete Setup', command=(partial(deleteSetup)))\n        cmds.setParent(top=1)\n        cmds.text(l='     Create / Edit Marker Points : ', h=30, al='left')\n        cmds.rowColumnLayout(nc=3)\n        cmds.text(l='     ')\n        cmds.rowColumnLayout(nc=3)\n        cmds.button(label='  Draw Topo Marker    ', command=(partial(drawPoints)))\n        cmds.text(l='  ')\n        cmds.button(label='  Mirror Markers  ', command=(partial(mirrorPoints)))\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.button(label='Tweak Markers A', command=(partial(tweakPointsA)))\n        cmds.text(l='  ')\n        cmds.button(label='Tweak Markers B', command=(partial(tweakPointsB)))\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.button(label='  Hide/Show Markers  ', command=(partial(hideUnhidePnts)))\n        cmds.text(l='  ')\n        cmds.button(label='  Toggle Marker Geo   ', command=(partial(toggleBallPnts)))\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.button(label=' Snap Markers to Geo ', command=(partial(snapMarkers)))\n        cmds.text(l='  ')\n        cmds.button(label='  Delete Marker-pair   ', command=(partial(deletePoints)))\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.button(label='Export Markers', command=(partial(exportPoints)))\n        cmds.text(l='  ')\n        cmds.button(label='Import Markers', command=(partial(importPoints)))\n        cmds.setParent(top=1)\n        cmds.text(l='     Edit TopoMesh : ', h=30, al='left')\n        cmds.rowColumnLayout(nc=3)\n        cmds.text(l='     ')\n        cmds.rowColumnLayout(nc=3)\n        cmds.button(label='   Create Exclude Set   ', command=(partial(createExcludeSet)))\n        cmds.text(l='  ')\n        cmds.button(label='   Toggle Ref Mode   ', command=(partial(toggleRefMode)))\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.text(l='  ', h=5)\n        cmds.button(label='   Paint Relax Topo    ', command=(partial(paintRelax)))\n        cmds.text(l='  ')\n        cmds.button(label='   Paint Retain Shape   ', command=(partial(paintRetainShape)))\n        cmds.setParent(top=1)\n        cmds.text(l='     Bake Textures : ', h=30, al='left')\n        cmds.rowColumnLayout(nc=3)\n        cmds.text(l='     ')\n        cmds.rowColumnLayout(nc=3)\n        cmds.columnLayout()\n        selectedMenuItem = cmds.optionMenu('res', label='Resolution')\n        a = cmds.menuItem(label='1024')\n        b = cmds.menuItem(label='2048')\n        c = cmds.menuItem(label='4096')\n        cmds.setParent('..')\n        cmds.text(l='     ')\n        cmds.button(label='   Bake Texture    ', command=(partial(bakeTex, selectedMenuItem)))\n        cmds.showWindow(windowID)\ntopoWrapUI()" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
