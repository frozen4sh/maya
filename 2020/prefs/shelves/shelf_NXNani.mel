        -backgroundColor 0 0 0 
        -highlightColor 0.321569 0.521569 0.65098 
        -align "center" 
        -label "// Copyright 2000-2001 Michael Bazhutkin - studio Klassika\n//\n//..." 
        -labelOffset 0
        -rotation 0
