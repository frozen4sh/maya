        -annotation "#-*- coding:utf-8 -*-\n#*************************************************************************************************\n'''\nCreated on 2021. 2. 24.\n@company : NXN\n@author : LeeSungJun\n@project : project_name\n@description :\n@history :\n             2021. 2. 24. :\n'''\n#*************************************************************************************************\nimport logging \n_logger = logging.getLogger(__name__)\n\nimport pymel.core as pm\nimport maya.cmds as cmds\nimport re\nimport os\n\nPOS_NAME = ['Jnt_POS','Geo_POS']\n\nclass AnimEnvLoader():\n    def __init__(self,items):\n        _logger.info(items)\n        self.base_loc = items[0]\n        self.env_grp = items[1]\n        self.pos_cube = POS_NAME[0]\n        self.pos_jnt = POS_NAME[1]\n        self.del_list = []\n\n    def create_pos(self):\n        if not pm.ls('%s*'%POS_NAME[1]):\n            create_cube = pm.polyCube(n =self.pos_cube)\n            pm.select(clear =True)\n            create_jnt = pm.joint(n=self.pos_jnt,o=[-90,0,0])\n            const_cube =pm.parentConstraint(create_jnt,create_cube,mo=False)\n            pm.delete(const_cube)\n            pm.skinCluster(create_jnt,create_cube)\n \n            self.set_pos(self.base_loc,create_jnt)\n            self.zero_env()\n        \n        else:\n            self.zero_env()\n            \n    def set_pos(self,parent_,jnt_):\n        #objs = pm.ls(self.pos_env)\n        const_ = pm.pointConstraint(parent_,jnt_,mo=False)\n        pm.delete(const_)\n     \n    def zero_env(self):\n        \n        env_jnt = pm.ls(self.pos_jnt)[0]\n        env_grp = pm.ls(self.env_grp)[0]\n        env_jnt_dup = pm.duplicate(env_jnt,n='%s_dup'%env_jnt)\n        env_parent = pm.parentConstraint(env_jnt_dup,env_grp,mo=True)\n        env_jnt_dup[0].tx.set(0)\n        env_jnt_dup[0].ty.set(0)\n        env_jnt_dup[0].tz.set(0)\n        pm.delete(env_parent)\n        pm.delete(env_jnt_dup)\n    \n    def main(self):\n        self.create_pos()\n        \n\nclass AnimEnvLoader_UI():\n    def __init__(self,):\n        self.init_UI()\n    \n    def init_UI(self):\n        if(cmds.window('AnimEnvLoader',q=1,ex=1)):cmds.deleteUI('AnimEnvLoader')\n        cmds.window('AnimEnvLoader',w=480,h=10,mb=1,resizeToFitChildren=True, sizeable=False)\n        cmds.columnLayout(adj=1)\n\n        cmds.button(label ='move to zero point',c=self.send_ref_file)\n        cmds.showWindow('AnimEnvLoader')\n   \n        \n    def send_ref_file(self,*args):\n        sel_items = pm.ls(sl=True)\n        if sel_items:\n            _ref = AnimEnvLoader(sel_items)\n            _ref.main()\n\nif __name__ == '__main__':\n    ui = AnimEnvLoader_UI()\n    " 
        -enableBackground 0
        -backgroundColor 0 0 0 
        -highlightColor 0.321569 0.521569 0.65098 
        -align "center" 
        -label "#-*- coding:utf-8 -*-\n#*****************************************..." 
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -imageOverlayLabel "Env" 
        -overlayLabelColor 0.8 0.8 0.8 
        -overlayLabelBackColor 0 0 0 0.5 
