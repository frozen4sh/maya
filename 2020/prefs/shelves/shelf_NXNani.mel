        -command "\n# -----------------------------------\n# Studio Library\n# www.studiolibrary.com\n# -----------------------------------\n\nimport os\nimport sys\n    \nif not os.path.exists(r'Z:\\Teams\\CINEMA\\03.Animation\\05.scrips\\studiolibrary\\src'):\n    raise IOError(r'The source path \"Z:\\Teams\\CINEMA\\03.Animation\\05.scrips\\studiolibrary\\src\" does not exist!')\n    \nif r'Z:\\Teams\\CINEMA\\03.Animation\\05.scrips\\studiolibrary\\src' not in sys.path:\n    sys.path.insert(0, r'Z:\\Teams\\CINEMA\\03.Animation\\05.scrips\\studiolibrary\\src')\n    \nimport studiolibrary\nstudiolibrary.main()\n" 
