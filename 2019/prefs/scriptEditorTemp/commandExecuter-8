global proc selectLeft(){
select "*Cntr_L";
select -d "*EyeCntr_L";
}


global proc selectRight(){
select "*Cntr_R";
select -d "*EyeCntr_R";
}

global proc selectFacial(){
//ui
if(`window -exists "ctrlUI"`){deleteUI ctrlUI;}

window -title ("Jnt & Ctrl") -sizeable off -titleBarMenu on ctrlUI;

formLayout ctrlUIform;

iconTextButton -style "textOnly" -label "Select Left" -w 150 -h 35 -backgroundColor 1 .25 .25 -command selectLeft jntPosBTN; 
iconTextButton -style "textOnly" -label "Select Right" -w 150 -h 35 -backgroundColor 0 .51 1 -command selectRight jntPlaceBTN;

formLayout -e

-attachForm jntPosBTN "top" 0
-attachForm jntPosBTN "left" 0

-attachForm jntPlaceBTN "top" 35
-attachForm jntPlaceBTN "left" 0

ctrlUIform;

showWindow ctrlUI;
window -e -w 150 -h 80 ctrlUI;

print("dongheeScript");
}

selectFacial;


