import maya.cmds as cmds

def shiftKeyframe(timeOffset):
    controllers = cmds.ls(sl= True)

    for each in controllers:
        cmds.keyframe(each, edit=True, relative=True, timeChange= timeOffset)



def keyframeShifter_GUI():
    
    if (cmds.window('ink_keyframeShifter', exists= True)):
        cmds.deleteUI('ink_keyframeShifter')
    
    win = cmds.window('ink_keyframeShifter', resizeToFitChildren= True, sizeable= False, mnb= False, mxb= False)
    
    cmds.rowColumnLayout( numberOfColumns= 6, adjustableColumn= True, cw=([1, 50],[2, 50],[3, 50],[4, 50],[5, 50],[6, 50]), cs= ([2, 10],[3, 10],[4, 10],[5, 10],[6, 10]),p= win)
    
    cmds.button('sub_100', label= '-100', h=50, bgc= [0.73,0.73,0.73], command= ('shiftKeyframe(-100)'))
    cmds.button('sub_10', label= '-10', h=50, bgc= [0.73,0.73,0.73], command= 'shiftKeyframe(-10)')
    cmds.button('sub_1', label= '-1', h=50, bgc= [0.73,0.73,0.73], command= 'shiftKeyframe(-1)')
    cmds.button('plus_1', label= '+1', h=50, bgc= [0.73,0.73,0.73], command= 'shiftKeyframe(1)')
    cmds.button('plus_10', label= '+10', h=50, bgc= [0.73,0.73,0.73], command= 'shiftKeyframe(10)')
    cmds.button('plus_100', label= '+100', h=50, bgc= [0.73,0.73,0.73], command= 'shiftKeyframe(100)')
    
    cmds.window(win, e= 1, widthHeight = [300,50], resizeToFitChildren= True)
    cmds.showWindow(win)

keyframeShifter_GUI()