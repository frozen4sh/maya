//
// The user hotkeys
//
//
// The hotkey set
//
hotkeySet -source "Maya_Default" -current Maya_Default_Duplicate;
//
// The hotkey contexts and hotkeys
//
hotkey -keyShortcut "3" -alt -name ("SelectFacetMaskNameCommand");
hotkey -keyShortcut "!" -name ("FreezeTransformationsNameCommand");
hotkey -keyShortcut "F9" -name ("");
hotkey -keyShortcut "n" -sht -name ("ReversePolygonNormalsNameCommand");
hotkey -keyShortcut "r" -alt -sht -name ("Reset_SNameCommand");
hotkey -keyShortcut "4" -alt -name ("SelectUVMaskNameCommand");
hotkey -keyShortcut "F6" -name ("GraphEditorNameCommand");
hotkey -keyShortcut "F12" -name ("HotkeyPreferencesWindowNameCommand");
hotkey -keyShortcut "a" -sht -name ("CombinePolygonsNameCommand");
hotkey -keyShortcut "1" -alt -name ("SelectVertexMaskNameCommand");
hotkey -keyShortcut "z" -ctl -sht -name ("SelectHierarchyNameCommand");
hotkey -keyShortcut "F4" -name ("TextureViewWindowNameCommand");
hotkey -keyShortcut "F3" -name ("");
hotkey -keyShortcut "~" -name ("CenterPivotNameCommand");
hotkey -keyShortcut "F5" -name ("HypershadeWindowNameCommand");
hotkey -keyShortcut "w" -alt -sht -name ("Reset_TNameCommand");
hotkey -keyShortcut "i" -ctl -name ("ImportNameCommand");
hotkey -keyShortcut "a" -releaseName ("");
hotkey -keyShortcut "a" -name ("FrameAllNameCommand");
hotkey -keyShortcut "x" -alt -name ("dR_objectXrayTGLNameCommand");
hotkey -keyShortcut "F10" -name ("");
hotkey -keyShortcut "F11" -name ("");
hotkey -keyShortcut "y" -sht -name ("SeparatePolygonNameCommand");
hotkey -keyShortcut "q" -sht -name ("SmoothPolygonNameCommand");
hotkey -keyShortcut "r" -ctl -sht -name ("ReferenceEditorNameCommand");
hotkey -keyShortcut "e" -alt -sht -name ("Reset_RNameCommand");
hotkey -keyShortcut "q" -sht -releaseName ("");
hotkey -keyShortcut "2" -alt -name ("SelectEdgeMaskNameCommand");
hotkey -keyShortcut "F2" -name ("");
hotkeyCtx -type "Editor" -addClient "outlinerPanel";
hotkeyCtx -type "Editor" -addClient "timeEditorPanel";
hotkeyCtx -type "Editor" -addClient "graphEditor";
hotkeyCtx -type "Editor" -addClient "shapePanel";
hotkeyCtx -type "Editor" -addClient "polyTexturePlacementPanel";
hotkey -keyShortcut "a" -name ("TogglePolyUVsCreateShaderNameCommand");
hotkeyCtx -type "Editor" -addClient "posePanel";
hotkeyCtx -type "Editor" -addClient "hyperShadePanel";
hotkeyCtx -type "Editor" -addClient "hyperGraphPanel";
hotkeyCtx -type "Editor" -addClient "nodeEditorPanel";
hotkeyCtx -type "Editor" -addClient "profilerPanel";
hotkeyCtx -type "Tool" -addClient "polyCutUV";
hotkeyCtx -type "Tool" -addClient "Unfold3DBrush";
hotkeyCtx -type "Tool" -addClient "xgmIGBrush";
hotkeyCtx -type "Tool" -addClient "texCutContext";
hotkeyCtx -type "Tool" -addClient "SymmetrizeUVBrush";
hotkeyCtx -type "Tool" -addClient "texSculptCacheContext";
hotkeyCtx -type "Tool" -addClient "sculptMeshCache";
