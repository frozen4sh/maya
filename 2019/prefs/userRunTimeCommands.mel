runTimeCommand
	-label ""
	-image ""
	-tags ""
	-keywords ""
	-plugin ""
	-annotation "Reset_T"
	-category "Custom Scripts"
	-hotkeyCtx ""
	-commandLanguage "python"
	-command ("import maya.cmds as cmds \nobjs = cmds.ls(sl= True) \naxis = ['X','Y','Z'] \nfor obj in objs: \n    for i,j in enumerate(axis): \n        if not cmds.getAttr('{0}.translate{1}'.format(obj, j), lock= True): \n            if cmds.getAttr('{0}.translate{1}'.format(obj, j), keyable= True): \n                cmds.setAttr('{0}.translate{1}'.format(obj, j), 0) ")
	Reset_T;

