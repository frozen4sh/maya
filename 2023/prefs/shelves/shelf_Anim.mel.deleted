    shelfButton
        -enableCommandRepeat 1
        -flexibleWidthType 2
        -flexibleWidthValue 32
        -enable 1
        -width 32
        -height 34
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "import maya.cmds as cmds\nimport maya.mel as mel\n\n\ndef cycleGraph(numCycle):\n\t# find the selected attributes\n\tgraphNames = cmds.keyframe(q=True, name=True, selected=True)\n\tnumGraphs = len(graphNames)\n\t\n\t# copy and paste keys\n\tfor i in range(numGraphs):\n\t\tkeyFrames = cmds.keyframe(graphNames[i], q=True)\n\t\tcmds.copyKey(graphNames[i], time=(keyFrames[0],keyFrames[-1]), option=\"curve\" )\n\t\tcmds.pasteKey(graphNames[i], time=(keyFrames[-1],), option=\"insert\", connect=1, copies=numCycle)\n\n\treturn \n\n\t\ndef duplicateGraph(srcObj, tgtObj):\n\t# copy the srcGraphs\n\ttgtGraphNames = cmds.keyframe(tgtObj, q=True, name=True)\n\tif tgtGraphNames != None:\n\t\tprint('The target object should be clean without any keyframes!')\n\t\treturn\n\t\t\n\tsrcGraphNames = cmds.keyframe(srcObj, q=True, name=True)\n\tnumSrcGraphs = len(srcGraphNames)\n\t\t\n\t# paste srcGraphs to tgtObject\t\n\tfor i in range(numSrcGraphs):\n\t\tsrcKeyFrames = cmds.keyframe(srcGraphNames[i], q=True)\n\t\t\t\t\n\t\tcmds.copyKey(srcGraphNames[i], time=(srcKeyFrames[0],srcKeyFrames[-1]), option=\"curve\" )\n\t\tcmds.pasteKey(tgtObj, time=(srcKeyFrames[0],), option=\"insert\", connect=1, copies=1)\n\t\t#cmds.pasteKey(tgtObj, time=(srcKeyFrames[0],), option=\"merge\", copies=1, valueOffset=5)\n\t\n\treturn\n\n\ndef appendGraph(srcObj, tgtObj):\n\t# copy the srcGraphs\n\tsrcGraphNames = cmds.keyframe(srcObj, q=True, name=True)\n\tnumSrcGraphs = len(srcGraphNames)\n\t\n\ttgtGraphNames = cmds.keyframe(tgtObj, q=True, name=True)\n\tnumTgtGraphs = len(tgtGraphNames)\n\n\tif numSrcGraphs != numSrcGraphs:\n\t\tprint('The number of key attributes of the source and the target is different!')\n\t\treturn\n\t\n\t# paste srcGraphs to tgtObject\n\tfor i in range(numSrcGraphs):\n\t\tsrcKeyFrames = cmds.keyframe(srcGraphNames[i], q=True)\n\t\ttgtKeyFrames = cmds.keyframe(tgtGraphNames[i], q=True)\n\t\t\n\t\tcmds.copyKey(srcGraphNames[i], time=(srcKeyFrames[0],srcKeyFrames[-1]), option=\"curve\" )\n\t\tcmds.pasteKey(tgtGraphNames[i], time=(tgtKeyFrames[-1],), option=\"insert\", connect=1, copies=1)\n\t\t#cmds.pasteKey(tgtGraphNames[i], time=(tgtKeyFrames[-1],), option=\"merge\", copies=1)\n   \t\n\treturn\n\nclass graphCyclerUI():\n\tdef __init__(self, winName=\"graphCyclerUI\"):\n\t\tself.winTitle = \"Graph Cycler\"\n\t\tself.winName = winName\n\t\tself.animCurves = None\n\n\tdef create(self):\n\t\tif cmds.window(self.winName, exists=True):\n\t\t\tcmds.deleteUI(self.winName)\n\n\t\tcmds.window(self.winName, title=self.winTitle)\n\t\tself.mainCol = cmds.columnLayout( adjustableColumn=True )\n\t\tcmds.frameLayout( labelVisible=False, borderStyle='etchedOut', width=250 )\n\t\tcmds.columnLayout( adjustableColumn=True, columnAttach=('both', 9) )\n\t\tcmds.text( label='', align='left' )\n\n\t\tcmds.rowColumnLayout( numberOfColumns=2, columnWidth=[(1, 100), (2, 120)])\n\t\tcmds.text( label='No. Cycles:', align='left' )\n\t\tself.numCycleText = cmds.intField()\n\t\tcmds.setParent('..')\n\n\t\tcmds.text( label='', align='left' )\n\t\tcmds.button(label='Cycle the Graphs', width=100, command=self.cycleGraphUI)\n\t\tcmds.text( label='', align='left' )\n\n\t\tcmds.button(label='Duplicate the Graphs', command=self.dupGraphUI)\n\t\tcmds.text( label='', align='left')\n\t\t\n\t\tcmds.button(label='Append the Graphs', command=self.appendGraphUI)\n\t\tcmds.text( label='', align='left')\n\n\t\tcmds.setParent('..')\n\t\tcmds.setParent('..')\n\n\t\tcmds.window(self.winName, edit=True, width=250, height=150)\n\t\tcmds.showWindow( self.winName )\n\t\treturn\n\n\tdef cycleGraphUI(self, arg=None):\n\t\tnumCycle = cmds.intField(self.numCycleText, query=1, value=1)\n\t\tcycleGraph(numCycle)\n\t\t\n\t\treturn\n\t\t\n\tdef dupGraphUI(self, arg=None):\n\t\tobjs = cmds.ls(sl=1)\n\t\tif len(objs) == 2:\n\t\t\tduplicateGraph(objs[0], objs[1])\n\t\telse:\n\t\t\tprint('select two objects in order of the source object and the target object')\n\t\t\n\t\treturn\n\t\t\n\tdef appendGraphUI(self, arg=None):\n\t\tobjs = cmds.ls(sl=1)\n\t\tif len(objs) == 2:\n\t\t\tappendGraph(objs[0], objs[1])\n\t\telse:\n\t\t\tprint('select two objects in order of the source object and the target object')\n\t\t\n\t\treturn\n\n\t\t\n# create the window\ngcyInst = graphCyclerUI()\ngcyInst.create()" 
