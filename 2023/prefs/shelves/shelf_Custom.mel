        -command "import maya.cmds as cmds\n\nbone_map = {\n    \"R_Pelvis\": \"Hips\",\n    \"R_Spine\": \"Spine\",\n    \"R_Spine1\": \"Spine1\",\n    \"R_Spine2\": \"Spine2\",\n    \"R_Neck\": \"Neck\",\n    \"R_Head\": \"Head\",\n    \"R_Jaw\": \"Jaw\",\n\n    \"R_L_Clavicle\": \"LeftShoulder\",\n    \"R_L_UpperArm\": \"LeftArm\",\n    \"R_L_Forearm\": \"LeftForeArm\",\n    \"R_L_Hand\": \"LeftHand\",\n    \"R_L_Finger0\": \"LeftHandThumb1\",\n    \"R_L_Finger01\": \"LeftHandThumb2\",\n    \"R_L_Finger02\": \"LeftHandThumb3\",\n    \"R_L_Finger1\": \"LeftHandIndex1\",\n    \"R_L_Finger11\": \"LeftHandIndex2\",\n    \"R_L_Finger12\": \"LeftHandIndex3\",\n    \"R_L_Finger2\": \"LeftHandMiddle1\",\n    \"R_L_Finger21\": \"LeftHandMiddle2\",\n    \"R_L_Finger22\": \"LeftHandMiddle3\",\n    \"R_L_Finger3\": \"LeftHandRing1\",\n    \"R_L_Finger31\": \"LeftHandRing2\",\n    \"R_L_Finger32\": \"LeftHandRing3\",\n    \"R_L_Finger4\": \"LeftHandPinky1\",\n    \"R_L_Finger41\": \"LeftHandPinky2\",\n    \"R_L_Finger42\": \"LeftHandPinky3\",\n\n    \"R_R_Clavicle\": \"RightShoulder\",\n    \"R_R_UpperArm\": \"RightArm\",\n    \"R_R_Forearm\": \"RightForeArm\",\n    \"R_R_Hand\": \"RightHand\",\n    \"R_R_Finger0\": \"RightHandThumb1\",\n    \"R_R_Finger01\": \"RightHandThumb2\",\n    \"R_R_Finger02\": \"RightHandThumb3\",\n    \"R_R_Finger1\": \"RightHandIndex1\",\n    \"R_R_Finger11\": \"RightHandIndex2\",\n    \"R_R_Finger12\": \"RightHandIndex3\",\n    \"R_R_Finger2\": \"RightHandMiddle1\",\n    \"R_R_Finger21\": \"RightHandMiddle2\",\n    \"R_R_Finger22\": \"RightHandMiddle3\",\n    \"R_R_Finger3\": \"RightHandRing1\",\n    \"R_R_Finger31\": \"RightHandRing2\",\n    \"R_R_Finger32\": \"RightHandRing3\",\n    \"R_R_Finger4\": \"RightHandPinky1\",\n    \"R_R_Finger41\": \"RightHandPinky2\",\n    \"R_R_Finger42\": \"RightHandPinky3\",\n\n    \"R_L_Thigh\": \"LeftUpLeg\",\n    \"R_L_Calf\": \"LeftLeg\",\n    \"R_L_Foot\": \"LeftFoot\",\n    \"R_L_Toe0\": \"LeftToeBase\",\n\n    \"R_R_Thigh\": \"RightUpLeg\",\n    \"R_R_Calf\": \"RightLeg\",\n    \"R_R_Foot\": \"RightFoot\",\n    \"R_R_Toe0\": \"RightToeBase\",\n\n    \"Root\": \"Root\"\n}\n\nfor old, new in bone_map.items():\n    if cmds.objExists(old):\n        try:\n            cmds.rename(old, new)\n            print(f\"Renamed {old} -> {new}\")\n        except:\n            print(f\"Failed to rename {old}\")\n    else:\n        print(f\"{old} not found in scene\")\n" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
    ;
