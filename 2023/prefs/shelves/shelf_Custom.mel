ut SKM_CH_Mem5_MVC:Mem5_HeadOnly:CTRL_R_mouth_cornerSharpnessU SKM_CH_Mem5_MVC:Mem5_HeadOnly:CTRL_L_mouth_cornerSharpnessD SKM_CH_Mem5_MVC:Mem5_HeadOnly:CTRL_C_tongue_thickThin SKM_CH_Mem5_MVC:Mem5_HeadOnly:CTRL_R_mouth_thicknessInwardD SKM_CH_Mem5_MVC:Mem5_HeadOnly:CTRL_L_mouth_thicknessInwardD SKM_CH_Mem5_MVC:Mem5_HeadOnly:CTRL_L_mouth_thicknessD SKM_CH_Mem5_MVC:Mem5_HeadOnly:CTRL_R_mouth_lipsRollD SKM_CH_Mem5_MVC:Mem5_HeadOnly:CTRL_C_mouth_lipShiftD SKM_CH_Mem5_MVC:Mem5_HeadOnly:CTRL_L_eye_faceScrunch ;\n" 
