import maya.cmds as cmds
import maya.mel as mel


def cycleGraph(numCycle):
	# find the selected attributes
	graphNames = cmds.keyframe(q=True, name=True, selected=True)
	numGraphs = len(graphNames)
	
	# copy and paste keys
	for i in range(numGraphs):
		keyFrames = cmds.keyframe(graphNames[i], q=True)
		cmds.copyKey(graphNames[i], time=(keyFrames[0],keyFrames[-1]), option="curve" )
		cmds.pasteKey(graphNames[i], time=(keyFrames[-1],), option="insert", connect=1, copies=numCycle)

	return 

	
def duplicateGraph(srcObj, tgtObj):
	# copy the srcGraphs
	tgtGraphNames = cmds.keyframe(tgtObj, q=True, name=True)
	if tgtGraphNames != None:
		print('The target object should be clean without any keyframes!')
		return
		
	srcGraphNames = cmds.keyframe(srcObj, q=True, name=True)
	numSrcGraphs = len(srcGraphNames)
		
	# paste srcGraphs to tgtObject	
	for i in range(numSrcGraphs):
		srcKeyFrames = cmds.keyframe(srcGraphNames[i], q=True)
				
		cmds.copyKey(srcGraphNames[i], time=(srcKeyFrames[0],srcKeyFrames[-1]), option="curve" )
		cmds.pasteKey(tgtObj, time=(srcKeyFrames[0],), option="insert", connect=1, copies=1)
		#cmds.pasteKey(tgtObj, time=(srcKeyFrames[0],), option="merge", copies=1, valueOffset=5)
	
	return


def appendGraph(srcObj, tgtObj):
	# copy the srcGraphs
	srcGraphNames = cmds.keyframe(srcObj, q=True, name=True)
	numSrcGraphs = len(srcGraphNames)
	
	tgtGraphNames = cmds.keyframe(tgtObj, q=True, name=True)
	numTgtGraphs = len(tgtGraphNames)

	if numSrcGraphs != numSrcGraphs:
		print('The number of key attributes of the source and the target is different!')
		return
	
	# paste srcGraphs to tgtObject
	for i in range(numSrcGraphs):
		srcKeyFrames = cmds.keyframe(srcGraphNames[i], q=True)
		tgtKeyFrames = cmds.keyframe(tgtGraphNames[i], q=True)
		
		cmds.copyKey(srcGraphNames[i], time=(srcKeyFrames[0],srcKeyFrames[-1]), option="curve" )
		cmds.pasteKey(tgtGraphNames[i], time=(tgtKeyFrames[-1],), option="insert", connect=1, copies=1)
		#cmds.pasteKey(tgtGraphNames[i], time=(tgtKeyFrames[-1],), option="merge", copies=1)
   	
	return

class graphCyclerUI():
	def __init__(self, winName="graphCyclerUI"):
		self.winTitle = "Graph Cycler"
		self.winName = winName
		self.animCurves = None

	def create(self):
		if cmds.window(self.winName, exists=True):
			cmds.deleteUI(self.winName)

		cmds.window(self.winName, title=self.winTitle)
		self.mainCol = cmds.columnLayout( adjustableColumn=True )
		cmds.frameLayout( labelVisible=False, borderStyle='etchedOut', width=250 )
		cmds.columnLayout( adjustableColumn=True, columnAttach=('both', 9) )
		cmds.text( label='', align='left' )

		cmds.rowColumnLayout( numberOfColumns=2, columnWidth=[(1, 100), (2, 120)])
		cmds.text( label='No. Cycles:', align='left' )
		self.numCycleText = cmds.intField()
		cmds.setParent('..')

		cmds.text( label='', align='left' )
		cmds.button(label='Cycle the Graphs', width=100, command=self.cycleGraphUI)
		cmds.text( label='', align='left' )

		cmds.button(label='Duplicate the Graphs', command=self.dupGraphUI)
		cmds.text( label='', align='left')
		
		cmds.button(label='Append the Graphs', command=self.appendGraphUI)
		cmds.text( label='', align='left')

		cmds.setParent('..')
		cmds.setParent('..')

		cmds.window(self.winName, edit=True, width=250, height=150)
		cmds.showWindow( self.winName )
		return

	def cycleGraphUI(self, arg=None):
		numCycle = cmds.intField(self.numCycleText, query=1, value=1)
		cycleGraph(numCycle)
		
		return
		
	def dupGraphUI(self, arg=None):
		objs = cmds.ls(sl=1)
		if len(objs) == 2:
			duplicateGraph(objs[0], objs[1])
		else:
			print('select two objects in order of the source object and the target object')
		
		return
		
	def appendGraphUI(self, arg=None):
		objs = cmds.ls(sl=1)
		if len(objs) == 2:
			appendGraph(objs[0], objs[1])
		else:
			print('select two objects in order of the source object and the target object')
		
		return

		
# create the window
gcyInst = graphCyclerUI()
gcyInst.create()