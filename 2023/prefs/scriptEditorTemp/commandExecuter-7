import maya.cmds as cmds

def change_namespace(old_namespace, new_namespace):
    """
    Change the namespace of all items from old_namespace to new_namespace.

    Parameters:
        old_namespace (str): The current namespace.
        new_namespace (str): The new namespace.
    """
    # Check if the old_namespace exists
    if cmds.namespace(exists=old_namespace):
        # List all items in the old_namespace
        items_in_namespace = cmds.namespaceInfo(old_namespace, listOnlyDependencyNodes=True, recurse=True)
        
        # Rename each item by replacing the old_namespace with the new_namespace
        for item in items_in_namespace:
            new_item_name = item.replace(old_namespace + ":", new_namespace + ":")
            cmds.rename(item, new_item_name)
        
        # Remove the old_namespace
        cmds.namespace(removeNamespace=old_namespace)
        print("Namespace changed from '{}' to '{}'.".format(old_namespace, new_namespace))
    else:
        print("Namespace '{}' does not exist.".format(old_namespace))

# Replace 'OldNamespace' and 'NewNamespace' with the actual namespaces you want to change
change_namespace("OldNamespace", "NewNamespace")
