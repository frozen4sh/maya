# -*- coding: utf-8 -*-
import maya.cmds as cmds
import maya.mel as mm

def pdf_strict_fbx_prepare():
    sel = cmds.ls(sl=True)
    if not sel:
        cmds.error("가이드 4번: Root 본을 선택해주세요!")
        return
        
    root_node = sel[0]

    # 1. 레퍼런스 강제 임포트 (가이드 2번) 애니메이션 FBX 추출 가이드.pdf]
    try:
        if cmds.referenceQuery(root_node, isNodeReferenced=True):
            ref_node = cmds.referenceQuery(root_node, referenceNode=True)
            ref_file = cmds.referenceQuery(ref_node, filename=True)
            cmds.file(ref_file, importReference=True)
    except:
        pass

    # 2. Hierarchy 선택 및 전체 베이크 (가이드 4, 5번) 애니메이션 FBX 추출 가이드.pdf]
    cmds.select(root_node, hi=True)
    all_hierarchy = cmds.ls(sl=True)
    
    start = cmds.playbackOptions(q=True, min=True)
    end = cmds.playbackOptions(q=True, max=True)
    
    cmds.bakeResults(all_hierarchy, simulation=True, t=(start, end), sampleBy=1, 
                     disableImplicitControl=True, preserveOutsideKeys=False, 
                     sparseAnimCurveBake=False, removeBakedAttributeFromLayer=False, 
                     bakeOnOverrideLayer=False, minimizeRotation=True, 
                     controlPoints=False, shape=True)

    # 3. 루트 본/하위 본 제외 나머지 삭제 (가이드 6번) 애니메이션 FBX 추출 가이드.pdf]
    cmds.select(root_node, hi=True)
    joints = cmds.ls(sl=True, type='joint')
    
    all_nodes = cmds.ls(root_node, dag=True)
    non_joints = [node for node in all_nodes if node not in joints and node != root_node]
    
    junk_nodes = cmds.ls(non_joints, type=['nurbsCurve', 'mesh', 'constraint'])
    if junk_nodes:
        transforms = cmds.listRelatives(junk_nodes, parent=True, fullPath=True) or []
        safe_transforms = [t for t in transforms if cmds.nodeType(t) != 'joint']
        try:
            cmds.delete(list(set(junk_nodes + safe_transforms)))
        except:
            pass



    # 5. 마무리 (저장 창 없이 선택 상태만 유지)
    root_base_name = root_node.split(":")[-1] 
    found_roots = cmds.ls("*" + root_base_name, type='joint')
    
    if found_roots:
        cmds.select(found_roots[0], hi=True)
        cmds.inViewMessage(amg="추출 준비 완료! 메뉴에서 File > Export Selection을 진행하세요.", pos='topCenter', fade=True)
    else:
        cmds.warning("정리는 완료되었으나 본을 찾을 수 없습니다. 수동으로 선택해 주세요.")

# 실행
pdf_strict_fbx_prepare()