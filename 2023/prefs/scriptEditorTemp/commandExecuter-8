    "ring_01_r",
    "ring_02_r",
    "ring_03_r",
    "pinky_01_r",
    "pinky_02_r",
    "pinky_03_r"
]

# 노란색 RGB
YELLOW = (1.0, 1.0, 0.0)

for bone in bone_names:
    if cmds.objExists(bone):
        cmds.setAttr(f"{bone}.overrideEnabled", 1)
        cmds.setAttr(f"{bone}.useOutlinerColor", 1)
        cmds.setAttr(f"{bone}.outlinerColor", *YELLOW)
    else:
        print(f"[Warning] Bone not found: {bone}")
