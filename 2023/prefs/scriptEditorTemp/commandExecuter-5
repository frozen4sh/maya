import maya.cmds as cmds

def create_joints_from_locators(root_locator):
    """
    root_locator 밑의 hierarchy를 joint hierarchy로 변환
    locator의 애니메이션도 joint로 복사 (bakeResults)
    """

    loc_to_joint = {}

    def build_hierarchy(loc, parent_joint=None):
        # locator 위치 얻기
        pos = cmds.xform(loc, q=True, ws=True, t=True)

        # ★ selection 비우고 joint 생성
        cmds.select(clear=True)
        jnt = cmds.joint(p=pos, name=loc.replace("R_", "J_").replace("L_", "J_"))
        loc_to_joint[loc] = jnt

        # hierarchy 연결
        if parent_joint:
            cmds.parent(jnt, parent_joint)

        # 자식 locator들 재귀 처리
        children = cmds.listRelatives(loc, c=True, type="transform") or []
        for child in children:
            build_hierarchy(child, jnt)

    # 루트부터 시작
    build_hierarchy(root_locator)

    # 애니메이션 복사 (locator → joint)
    for loc, jnt in loc_to_joint.items():
        cns = cmds.parentConstraint(loc, jnt, mo=False)
        cmds.bakeResults(jnt,
                         t=(cmds.playbackOptions(q=True, min=True),
                            cmds.playbackOptions(q=True, max=True)))
        cmds.delete(cns)

    print("✅ Locator hierarchy → Joint hierarchy 변환 완료!")

# 실행 예시:
create_joints_from_locators("R_CG")
