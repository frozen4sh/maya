import csv
import maya.cmds as cmds

# Define the frame rate of your animation (frames per second)
frame_rate = 60

# Define the path to your CSV file
csv_file = "D:/Justin/MetahumanFacialCSVTest/260203_Serene_9_Mem_1_raw.csv"

def timecode_to_frame(timecode):
    """
    Convert timecode to frame based on 60fps frame rate format.
    """
    # Split the timecode into its components
    hours, minutes, seconds, frames = map(float, timecode.split(':'))
    
    # Convert timecode to frame
    total_seconds = hours * 3600 + minutes * 60 + seconds + frames / 60
    frame = int(total_seconds * frame_rate)
    
    return frame

def import_and_set_keyframes(csv_file):
    with open(csv_file, 'r') as file:
        reader = csv.DictReader(file)
        
        # Iterate through each row in the CSV
        for row in reader:
            timecode = row['Timecode']
            frame = timecode_to_frame(timecode)  # Convert timecode to frame
            
            # Iterate through each column (controller) in the row
            for controller, value in row.items():
                # Skip the 'Timecode' column
                if controller == 'Timecode':
                    continue
                
                # Set the attribute value using setAttr command
                try:
                    # Construct the full controller name
                    full_controller_name = controller
                    
                    # Set attribute value
                    cmds.setAttr(full_controller_name, float(value))
                    
                    # Set keyframe at the converted frame
                    cmds.setKeyframe(full_controller_name, time=frame)
                except Exception as e:
                    print(f"Error setting keyframe for {full_controller_name}: {e}")
                    
                    # If keyframe setting fails, print the error and continue to the next keyframe

# Call the function to import CSV and set keyframes
import_and_set_keyframes(csv_file)

# Perform interpolation to fill in missing frames
cmds.select(all=True)
cmds.keyTangent(inTangentType='linear', outTangentType='linear')
